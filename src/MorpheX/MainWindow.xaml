<ui:FluentWindow
    x:Class="MorpheX.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:MorpheX"
    Title="MorpheX Live"
    Icon="pack://application:,,,/MorpheX;component/Assets/Branding/morphex-icon.ico"
    Width="1200"
    Height="750"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Grid.Row="0"
            ShowMaximize="True"
            ShowMinimize="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image
                        Source="pack://application:,,,/MorpheX;component/Assets/Branding/morphex-icon.png"
                        Width="18" Height="18"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0" />
                    <TextBlock
                        Text="MorpheX Live"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <Button
                    x:Name="ThemeToggleButton"
                    Width="32" Height="28"
                    Margin="0,0,6,0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Toggle Theme (Light / Dark)"
                    Click="ThemeToggleButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="Transparent" CornerRadius="6" Width="32" Height="28">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <ui:SymbolIcon x:Name="ThemeToggleIcon" Symbol="WeatherSunny24" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:NavigationView
                x:Name="NavigationView"
                Grid.Column="0"
                PaneDisplayMode="Left"
                IsBackButtonVisible="Collapsed"
                OpenPaneLength="240"
                IsPaneToggleVisible="False"
                IsPaneOpen="True">

                <ui:NavigationView.Header>
                    <Border Padding="16,12,16,14" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Image
                                Source="pack://application:,,,/MorpheX;component/Assets/Branding/morphex-icon.png"
                                Width="26" Height="26"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    Text="MorpheX Live"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock
                                    Text="Wallpaper Engine"
                                    FontSize="11"
                                    Opacity="0.5"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ui:NavigationView.Header>

                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem
                        x:Name="NavLibrary"
                        Content="Library"
                        Icon="{ui:SymbolIcon Image24}"
                        TargetPageType="{x:Type local:LibraryPage}"
                        IsActive="True" />
                    <ui:NavigationViewItem
                        x:Name="NavFavorites"
                        Content="Favorites"
                        Icon="{ui:SymbolIcon Heart24}"
                        TargetPageType="{x:Type local:FavoritesPage}" />
                    <ui:NavigationViewItem
                        x:Name="NavDisplays"
                        Content="Displays"
                        Icon="{ui:SymbolIcon Desktop24}"
                        TargetPageType="{x:Type local:DisplaysPage}" />
                    <ui:NavigationViewItem
                        x:Name="NavWidgets"
                        Content="Widgets"
                        Icon="{ui:SymbolIcon AppsList24}"
                        TargetPageType="{x:Type local:WidgetsPage}" />
                    <ui:NavigationViewItem
                        x:Name="NavProfiles"
                        Content="Profiles"
                        Icon="{ui:SymbolIcon Layer24}"
                        TargetPageType="{x:Type local:ProfilesPage}" />
                    <ui:NavigationViewItem
                        x:Name="NavEffects"
                        Content="Effects"
                        Icon="{ui:SymbolIcon Color24}"
                        TargetPageType="{x:Type local:EffectsPage}" />
                    <ui:NavigationViewItem
                        x:Name="NavKeybinds"
                        Content="Keybinds"
                        Icon="{ui:SymbolIcon Keyboard24}"
                        TargetPageType="{x:Type local:KeybindsPage}" />
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem
                        x:Name="NavSettings"
                        Content="Settings"
                        Icon="{ui:SymbolIcon Settings24}"
                        TargetPageType="{x:Type local:SettingsPage}" />
                </ui:NavigationView.FooterMenuItems>

            </ui:NavigationView>

            <!-- ── CONTENT ── -->
            <Frame
                x:Name="ContentFrame"
                Grid.Column="1"
                NavigationUIVisibility="Hidden"
                Margin="0" />
        </Grid>

        <Border
            x:Name="SystemStatsBar"
            Grid.Row="2"
            Height="32"
            Background="{StaticResource MxStatusBarBrush}"
            BorderBrush="{StaticResource MxStatusBarBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.7">
                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,7,0" />
                <TextBlock
                    Text="Engine Active"
                    FontSize="11"
                    FontWeight="Medium"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
