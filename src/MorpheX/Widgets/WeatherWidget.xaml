<Window
    x:Class="MorpheX.Widgets.WeatherWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MorpheX Weather"
    SizeToContent="WidthAndHeight"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="False"
    ResizeMode="NoResize">

    <Window.ContextMenu>
        <ContextMenu Background="#1A1A1E" BorderBrush="#30FFFFFF" Foreground="#FFFFFF" Padding="4">
            <MenuItem Header="Refresh Now" Click="RefreshNow_Click" Foreground="#FFFFFF"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem x:Name="ThemeMenuItem" Header="Light Theme" Click="ToggleTheme_Click" Foreground="#FFFFFF"/>
            <MenuItem x:Name="UnitsMenuItem" Header="Switch to °F" Click="ToggleUnits_Click" Foreground="#FFFFFF"/>
            <MenuItem x:Name="LockMenuItem" Header="Lock Position" Click="LockPosition_Click" Foreground="#FFD700"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="Close Widget" Click="CloseWidget_Click" Foreground="#FF8888"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <DropShadowEffect x:Key="Glow" BlurRadius="18" ShadowDepth="0" Color="#000000" Opacity="0.55"/>
    </Window.Resources>

    <Border
        x:Name="CardBorder"
        Margin="6"
        CornerRadius="14"
        Background="#B8101013"
        MinWidth="200"
        Effect="{StaticResource Glow}"
        MouseLeftButtonDown="Widget_MouseLeftButtonDown"
        Cursor="SizeAll">

        <StackPanel Margin="16,14,16,14">

            <!-- Location + refresh icon -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="LocationText"
                    Grid.Column="0"
                    Text="Weather"
                    FontSize="11"
                    FontFamily="Segoe UI"
                    Foreground="#88FFFFFF"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="LastUpdatedText"
                    Grid.Column="1"
                    Text="—"
                    FontSize="10"
                    Foreground="#55FFFFFF"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Main temp + icon row -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="WeatherEmojiText"
                    Grid.Column="0"
                    Text="🌤"
                    FontSize="48"
                    VerticalAlignment="Center"
                    Margin="0,0,14,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TempText"
                        Text="—°"
                        FontSize="42"
                        FontFamily="Bahnschrift Light, Segoe UI Light"
                        Foreground="#FFFFFF"
                        LineHeight="44" />
                    <TextBlock
                        x:Name="ConditionText"
                        Text="Loading..."
                        FontSize="12"
                        FontFamily="Segoe UI"
                        Foreground="#AAFFFFFF"
                        TextWrapping="Wrap"
                        MaxWidth="120" />
                </StackPanel>
            </Grid>

            <!-- Hi/Lo + humidity row -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock
                    x:Name="HiLoText"
                    Text="↑ — / ↓ —"
                    FontSize="11"
                    FontFamily="Segoe UI"
                    Foreground="#88FFFFFF"
                    Margin="0,0,12,0" />
                <TextBlock
                    x:Name="HumidityText"
                    Text="💧 —%"
                    FontSize="11"
                    FontFamily="Segoe UI"
                    Foreground="#88FFFFFF" />
            </StackPanel>

            <!-- Wind -->
            <TextBlock
                x:Name="WindText"
                Text="💨 — km/h"
                FontSize="11"
                FontFamily="Segoe UI"
                Foreground="#66FFFFFF" />

            <!-- Error text (hidden by default) -->
            <TextBlock
                x:Name="ErrorText"
                Text=""
                FontSize="10"
                Foreground="#FF8888"
                TextWrapping="Wrap"
                MaxWidth="180"
                Margin="0,6,0,0"
                Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
