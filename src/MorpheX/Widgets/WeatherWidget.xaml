<Window
    x:Class="MorpheX.Widgets.WeatherWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MorpheX Weather"
    SizeToContent="WidthAndHeight"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="False"
    ResizeMode="NoResize">

    <Window.ContextMenu>
        <ContextMenu Background="#1A1A1E" BorderBrush="#30FFFFFF" Foreground="#FFFFFF" Padding="4">
            <MenuItem Header="Refresh Now" Click="RefreshNow_Click" Foreground="#FFFFFF"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="📍 Set Location..." Click="SetLocation_Click" Foreground="#38BDF8"/>
            <MenuItem Header="📍 Auto-Detect Location" Click="AutoDetectLocation_Click" Foreground="#FFFFFF"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem x:Name="UnitsMenuItem" Header="Switch to °F" Click="ToggleUnits_Click" Foreground="#FFFFFF"/>
            <MenuItem x:Name="ThemeMenuItem" Header="Light Theme" Click="ToggleTheme_Click" Foreground="#FFFFFF"/>
            <MenuItem x:Name="CardBgMenuItem" Header="Disable Frosted Card" Click="ToggleCardBg_Click" Foreground="#FFFFFF"/>
            <MenuItem Header="Show / Hide Details" Foreground="#FFFFFF">
                <MenuItem x:Name="HiLoMenuItem" Header="High / Low Temp" IsCheckable="True" Click="ToggleHiLo_Click"/>
                <MenuItem x:Name="HumidityMenuItem" Header="Humidity" IsCheckable="True" Click="ToggleHumidity_Click"/>
                <MenuItem x:Name="WindMenuItem" Header="Wind Speed" IsCheckable="True" Click="ToggleWind_Click"/>
            </MenuItem>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem x:Name="LockMenuItem" Header="Lock Position" Click="LockPosition_Click" Foreground="#FFD700"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="Close Widget" Click="CloseWidget_Click" Foreground="#FF8888"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <DropShadowEffect x:Key="Glow" BlurRadius="18" ShadowDepth="0" Color="#000000" Opacity="0.55"/>
    </Window.Resources>

    <Border
        x:Name="CardBorder"
        Margin="6"
        CornerRadius="14"
        Background="#B8101013"
        MinWidth="180"
        Effect="{StaticResource Glow}"
        MouseLeftButtonDown="Widget_MouseLeftButtonDown"
        Cursor="SizeAll">

        <Border.LayoutTransform>
            <ScaleTransform x:Name="WidgetScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
        </Border.LayoutTransform>

        <StackPanel Margin="16,14,16,14">

            <!-- Location row (no time display) -->
            <TextBlock
                x:Name="LocationText"
                Text="Weather"
                FontSize="11"
                FontFamily="Segoe UI"
                Foreground="#88FFFFFF"
                Cursor="Hand"
                ToolTip="Click to change location (or right-click)"
                MouseLeftButtonDown="LocationText_Click"
                Margin="0,0,0,6" />

            <!-- Main temp + icon row -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="WeatherEmojiText"
                    Grid.Column="0"
                    Text="🌤"
                    FontSize="46"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TempText"
                        Text="—°"
                        FontSize="40"
                        FontFamily="Bahnschrift Light, Segoe UI Light"
                        Foreground="#FFFFFF"
                        LineHeight="42" />
                    <TextBlock
                        x:Name="ConditionText"
                        Text="Loading..."
                        FontSize="12"
                        FontFamily="Segoe UI"
                        Foreground="#AAFFFFFF"
                        TextWrapping="Wrap"
                        MaxWidth="130" />
                </StackPanel>
            </Grid>

            <!-- Hi/Lo + humidity row -->
            <StackPanel x:Name="HiLoHumidityRow" Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock
                    x:Name="HiLoText"
                    Text="↑ — / ↓ —"
                    FontSize="11"
                    FontFamily="Segoe UI"
                    Foreground="#88FFFFFF"
                    Margin="0,0,12,0" />
                <TextBlock
                    x:Name="HumidityText"
                    Text="💧 —%"
                    FontSize="11"
                    FontFamily="Segoe UI"
                    Foreground="#88FFFFFF" />
            </StackPanel>

            <!-- Wind -->
            <TextBlock
                x:Name="WindText"
                Text="💨 — km/h"
                FontSize="11"
                FontFamily="Segoe UI"
                Foreground="#66FFFFFF" />

            <!-- Error text (hidden by default) -->
            <TextBlock
                x:Name="ErrorText"
                Text=""
                FontSize="10"
                Foreground="#FF8888"
                TextWrapping="Wrap"
                MaxWidth="180"
                Margin="0,6,0,0"
                Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
