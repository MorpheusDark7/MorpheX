<Window
    x:Class="MorpheX.Widgets.SystemMonitorWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MorpheX System Monitor"
    SizeToContent="WidthAndHeight"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="False"
    ResizeMode="NoResize">

    <Window.Resources>
        <DropShadowEffect x:Key="WidgetShadow" BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.6"/>
    </Window.Resources>

    <Border
        Margin="8"
        CornerRadius="14"
        Background="#D90E0E10"
        BorderBrush="#25FFFFFF"
        BorderThickness="1"
        Effect="{StaticResource WidgetShadow}"
        MouseLeftButtonDown="Widget_MouseLeftButtonDown"
        Cursor="SizeAll">

        <StackPanel Margin="14,12">

            <!-- Header -->
            <DockPanel Margin="0,0,0,10">
                <TextBlock
                    Text="SYSTEM METRICS"
                    FontSize="9"
                    FontWeight="Bold"
                    FontFamily="Segoe UI"
                    Foreground="#77FFFFFF"
                    VerticalAlignment="Center"/>
                <Ellipse
                    Width="5" Height="5"
                    Fill="#CCCCCC"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>
            </DockPanel>

            <!-- 3 Circular Dials (B&W/Gray Theme) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <!-- CPU Circle -->
                <Grid Width="58" Height="58" Margin="0,0,10,0">
                    <Ellipse Width="46" Height="46" Stroke="#20FFFFFF" StrokeThickness="3.5"/>
                    <Path x:Name="CpuArc" Stroke="#FFFFFF" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="CpuText" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="CPU" FontSize="8" FontWeight="SemiBold" Foreground="#77FFFFFF" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- GPU Circle -->
                <Grid Width="58" Height="58" Margin="0,0,10,0">
                    <Ellipse Width="46" Height="46" Stroke="#20FFFFFF" StrokeThickness="3.5"/>
                    <Path x:Name="GpuArc" Stroke="#E0E0E0" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="GpuText" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="GPU" FontSize="8" FontWeight="SemiBold" Foreground="#77FFFFFF" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- RAM Circle -->
                <Grid Width="58" Height="58">
                    <Ellipse Width="46" Height="46" Stroke="#20FFFFFF" StrokeThickness="3.5"/>
                    <Path x:Name="RamArc" Stroke="#FFFFFF" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="RamText" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="RAM" FontSize="8" FontWeight="SemiBold" Foreground="#77FFFFFF" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                    </StackPanel>
                </Grid>

            </StackPanel>

            <!-- RAM Detail footer -->
            <TextBlock
                x:Name="RamDetailText"
                Text="RAM: 0.0 / 0.0 GB"
                FontSize="9.5"
                FontFamily="Segoe UI"
                Foreground="#66FFFFFF"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"/>

        </StackPanel>
    </Border>
</Window>
