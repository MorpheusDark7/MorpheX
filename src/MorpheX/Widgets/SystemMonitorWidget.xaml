<Window
    x:Class="MorpheX.Widgets.SystemMonitorWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MorpheX System Monitor"
    Width="210" Height="175"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="False"
    ResizeMode="NoResize">

    <Window.Resources>
        <DropShadowEffect x:Key="WidgetShadow" BlurRadius="18" ShadowDepth="4" Color="#000000" Opacity="0.55"/>
    </Window.Resources>

    <Border
        CornerRadius="12"
        Background="#CC0F0F0F"
        BorderBrush="#33FFFFFF"
        BorderThickness="1"
        Effect="{StaticResource WidgetShadow}"
        MouseLeftButtonDown="Widget_MouseLeftButtonDown"
        Cursor="SizeAll">

        <StackPanel Margin="16,12">

            <!-- Header -->
            <TextBlock
                Text="SYSTEM"
                FontSize="9"
                FontWeight="Bold"
                FontFamily="Segoe UI"
                Foreground="#66FFFFFF"
                Margin="0,0,0,8"/>

            <!-- CPU Row -->
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="CPU" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Height="5" CornerRadius="3" Background="#22FFFFFF" VerticalAlignment="Center">
                    <Border x:Name="CpuBar" CornerRadius="3" Background="#38BDF8" HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="CpuText" Grid.Column="2" Text="0%" FontSize="11" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- GPU Row -->
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="GPU" FontSize="10" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Height="5" CornerRadius="3" Background="#22FFFFFF" VerticalAlignment="Center">
                    <Border x:Name="GpuBar" CornerRadius="3" Background="#A78BFA" HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="GpuText" Grid.Column="2" Text="0%" FontSize="11" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- RAM Row -->
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="RAM" FontSize="10" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Height="5" CornerRadius="3" Background="#22FFFFFF" VerticalAlignment="Center">
                    <Border x:Name="RamBar" CornerRadius="3" Background="#34D399" HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="RamText" Grid.Column="2" Text="0%" FontSize="11" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- RAM GB detail -->
            <TextBlock x:Name="RamDetailText" Text="0.0 / 0.0 GB"
                FontSize="10" Foreground="#55FFFFFF" HorizontalAlignment="Right" Margin="0,-4,0,0"/>

        </StackPanel>
    </Border>
</Window>
