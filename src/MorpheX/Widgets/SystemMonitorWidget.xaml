<Window
    x:Class="MorpheX.Widgets.SystemMonitorWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MorpheX System Monitor"
    SizeToContent="WidthAndHeight"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="False"
    ResizeMode="NoResize">

    <Window.ContextMenu>
        <ContextMenu Background="#1A1A1E" BorderBrush="#30FFFFFF" Foreground="#FFFFFF" Padding="4">
            <MenuItem Header="⚡  System Monitor" IsEnabled="False" Foreground="#88FFFFFF"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="🔡  Small" Click="SizeSmall_Click" Foreground="#AAFFFFFF"/>
            <MenuItem Header="🔡  Medium" Click="SizeMedium_Click" Foreground="#AAFFFFFF"/>
            <MenuItem Header="🔡  Large" Click="SizeLarge_Click" Foreground="#AAFFFFFF"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem x:Name="LockMenuItem" Header="🔒  Lock Position" Click="LockPosition_Click" Foreground="#FFD700"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="❌  Close Widget" Click="CloseWidget_Click" Foreground="#FF8888"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Pure floating UI — no background box, Rainmeter style -->
    <StackPanel
        x:Name="RootPanel"
        Orientation="Horizontal"
        MouseLeftButtonDown="Widget_MouseLeftButtonDown"
        Cursor="SizeAll"
        Margin="0">

        <!-- CPU -->
        <StackPanel x:Name="CpuPanel" Margin="0,0,16,0" HorizontalAlignment="Center">
            <Grid x:Name="CpuGrid" Width="52" Height="52">
                <!-- Track ring -->
                <Ellipse Stroke="#25FFFFFF" StrokeThickness="3.5" Width="46" Height="46"/>
                <!-- Progress arc -->
                <Path x:Name="CpuArc" Stroke="#DDFFFFFF" StrokeThickness="3.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <!-- % text -->
                <TextBlock x:Name="CpuText" Text="0%"
                           FontSize="11" FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="CPU"
                       FontSize="10" FontWeight="Light"
                       FontFamily="Segoe UI Light, Segoe UI"
                       Foreground="#88FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- GPU -->
        <StackPanel x:Name="GpuPanel" Margin="0,0,16,0" HorizontalAlignment="Center">
            <Grid x:Name="GpuGrid" Width="52" Height="52">
                <Ellipse Stroke="#25FFFFFF" StrokeThickness="3.5" Width="46" Height="46"/>
                <Path x:Name="GpuArc" Stroke="#DDFFFFFF" StrokeThickness="3.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <TextBlock x:Name="GpuText" Text="0%"
                           FontSize="11" FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="GPU"
                       FontSize="10" FontWeight="Light"
                       FontFamily="Segoe UI Light, Segoe UI"
                       Foreground="#88FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- RAM -->
        <StackPanel x:Name="RamPanel" Margin="0,0,16,0" HorizontalAlignment="Center">
            <Grid x:Name="RamGrid" Width="52" Height="52">
                <Ellipse Stroke="#25FFFFFF" StrokeThickness="3.5" Width="46" Height="46"/>
                <Path x:Name="RamArc" Stroke="#DDFFFFFF" StrokeThickness="3.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <TextBlock x:Name="RamText" Text="0%"
                           FontSize="11" FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="RAM"
                       FontSize="10" FontWeight="Light"
                       FontFamily="Segoe UI Light, Segoe UI"
                       Foreground="#88FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- RAM GB detail (optional, shown as 4th element) -->
        <StackPanel x:Name="RamGbPanel" Margin="0,0,0,0" HorizontalAlignment="Center">
            <Grid x:Name="RamGbGrid" Width="52" Height="52">
                <Ellipse Stroke="#18FFFFFF" StrokeThickness="3.5" Width="46" Height="46"/>
                <!-- No arc for this one — just text -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="RamUsedText" Text="0"
                               FontSize="12" FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               Foreground="#CCFFFFFF"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="GB"
                               FontSize="8" FontWeight="Light"
                               FontFamily="Segoe UI Light"
                               Foreground="#66FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,-2,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="MEM"
                       FontSize="10" FontWeight="Light"
                       FontFamily="Segoe UI Light, Segoe UI"
                       Foreground="#88FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

    </StackPanel>
</Window>
