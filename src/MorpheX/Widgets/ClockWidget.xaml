<Window
    x:Class="MorpheX.Widgets.ClockWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MorpheX Clock Widget"
    SizeToContent="WidthAndHeight"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="False"
    ResizeMode="NoResize">

    <Window.Resources>
        <DropShadowEffect x:Key="WidgetShadow" BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.6" />
    </Window.Resources>

    <Border
        Margin="8"
        CornerRadius="14"
        Background="#D90E0E10"
        BorderBrush="#25FFFFFF"
        BorderThickness="1"
        Effect="{StaticResource WidgetShadow}"
        MouseLeftButtonDown="Widget_MouseLeftButtonDown"
        ToolTip="Drag to move • Double-click to toggle 12h / 24h"
        Cursor="SizeAll">

        <Grid Margin="18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="TimeText"
                Grid.Row="0"
                Text="00:00:00"
                FontSize="28"
                FontWeight="Light"
                FontFamily="Segoe UI"
                Foreground="#FFFFFF"
                HorizontalAlignment="Center" />

            <TextBlock
                x:Name="DateText"
                Grid.Row="1"
                Text="Monday, January 1"
                FontSize="11"
                FontFamily="Segoe UI"
                Foreground="#88FFFFFF"
                HorizontalAlignment="Center"
                Margin="0,3,0,0" />
        </Grid>
    </Border>
</Window>
