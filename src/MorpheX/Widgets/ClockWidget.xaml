<Window
    x:Class="MorpheX.Widgets.ClockWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MorpheX Clock Widget"
    Width="210" Height="92"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="False"
    ResizeMode="NoResize">

    <Window.Resources>
        <DropShadowEffect x:Key="WidgetShadow" BlurRadius="18" ShadowDepth="4" Color="#000000" Opacity="0.55" />
    </Window.Resources>

    <Border
        CornerRadius="12"
        Background="#CC0F0F0F"
        BorderBrush="#33FFFFFF"
        BorderThickness="1"
        Effect="{StaticResource WidgetShadow}"
        MouseLeftButtonDown="Widget_MouseLeftButtonDown"
        Cursor="SizeAll">

        <Grid Margin="18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="TimeText"
                Grid.Row="0"
                Text="00:00:00"
                FontSize="30"
                FontWeight="Light"
                FontFamily="Segoe UI"
                Foreground="White"
                HorizontalAlignment="Center" />

            <TextBlock
                x:Name="DateText"
                Grid.Row="1"
                Text="Monday, January 1"
                FontSize="11"
                FontFamily="Segoe UI"
                Foreground="#99FFFFFF"
                HorizontalAlignment="Center"
                Margin="0,3,0,0" />
        </Grid>
    </Border>
</Window>
