<Window
    x:Class="MorpheX.Widgets.TaskbarStatsWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MorpheX Taskbar Stats"
    SizeToContent="WidthAndHeight"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="True"
    ResizeMode="NoResize">

    <Window.ContextMenu>
        <ContextMenu Background="#1A1A1E" BorderBrush="#30FFFFFF" Foreground="#FFFFFF" Padding="4">
            <MenuItem Header="📊  Taskbar Stats" IsEnabled="False" Foreground="#88FFFFFF"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="📍  Snap to Taskbar" Click="SnapToTaskbar_Click" Foreground="#38BDF8"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem x:Name="LockMenuItem" Header="🔒  Lock Position" Click="LockPosition_Click" Foreground="#FFD700"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="❌  Close Widget" Click="CloseWidget_Click" Foreground="#FF8888"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Ultra-slim pill strip — transparent dark background -->
    <Border
        x:Name="RootBorder"
        CornerRadius="8"
        Background="#CC0D0D10"
        MouseLeftButtonDown="Widget_MouseLeftButtonDown"
        Cursor="SizeAll"
        Padding="12,5,12,5">

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- CPU -->
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <TextBlock Text="CPU" FontSize="9" FontWeight="SemiBold"
                           FontFamily="Segoe UI" Foreground="#66FFFFFF"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="CpuText" Text="0%"
                           FontSize="11" FontWeight="Bold"
                           FontFamily="Segoe UI" Foreground="#EEFFFFFF"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Divider -->
            <Rectangle Width="1" Height="14" Fill="#20FFFFFF" Margin="0,0,16,0" VerticalAlignment="Center"/>

            <!-- RAM -->
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <TextBlock Text="RAM" FontSize="9" FontWeight="SemiBold"
                           FontFamily="Segoe UI" Foreground="#66FFFFFF"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="RamText" Text="0 GB"
                           FontSize="11" FontWeight="Bold"
                           FontFamily="Segoe UI" Foreground="#EEFFFFFF"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Divider -->
            <Rectangle Width="1" Height="14" Fill="#20FFFFFF" Margin="0,0,16,0" VerticalAlignment="Center"/>

            <!-- GPU -->
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                <TextBlock Text="GPU" FontSize="9" FontWeight="SemiBold"
                           FontFamily="Segoe UI" Foreground="#66FFFFFF"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="GpuText" Text="0%"
                           FontSize="11" FontWeight="Bold"
                           FontFamily="Segoe UI" Foreground="#EEFFFFFF"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Divider -->
            <Rectangle Width="1" Height="14" Fill="#20FFFFFF" Margin="0,0,16,0" VerticalAlignment="Center"/>

            <!-- DISK -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="DISK" FontSize="9" FontWeight="SemiBold"
                           FontFamily="Segoe UI" Foreground="#66FFFFFF"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock x:Name="DiskText" Text="0%"
                           FontSize="11" FontWeight="Bold"
                           FontFamily="Segoe UI" Foreground="#EEFFFFFF"
                           VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
