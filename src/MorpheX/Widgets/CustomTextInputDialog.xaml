<Window
    x:Class="MorpheX.Widgets.CustomTextInputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MorpheX"
    Width="360"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False">
    <Border Margin="12" Background="#1C1C28" CornerRadius="12" BorderBrush="#32324C" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="28" Opacity="0.7" ShadowDepth="6"/></Border.Effect>
        <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="18,14,14,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Day Widget - Custom Text" FontSize="11" FontWeight="SemiBold" Foreground="#8A92A6" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="X" Width="24" Height="24" FontSize="11" Foreground="#8A92A6" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Cancel_Click"/>
            </Grid>
            <StackPanel Grid.Row="1" Margin="18,0,18,16">
                <TextBlock Text="Enter text to display" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                <TextBlock Text="Up to 20 characters. Right-click the widget and choose Use Weekday Name to revert." FontSize="12" Foreground="#9099B0" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12"/>
                <TextBox x:Name="InputBox" MaxLength="20" FontSize="16" FontFamily="Bahnschrift Light, Segoe UI Light" Foreground="#FFFFFF" Background="#12121E" BorderBrush="#40404C" BorderThickness="1" Padding="10,8" CaretBrush="{DynamicResource MxAccentBrush}" SelectionBrush="{DynamicResource MxAccentSubtleBrush}" TextChanged="InputBox_TextChanged" KeyDown="InputBox_KeyDown"/>
                <TextBlock x:Name="CharCounter" Text="0 / 20" FontSize="10" Foreground="#606080" HorizontalAlignment="Right" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Row="2" Background="#161622" CornerRadius="0,0,11,11" BorderBrush="#252538" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="80" Height="32" Margin="0,0,8,0" FontSize="13" Foreground="#9099B0" Background="#22222E" BorderBrush="#35354A" BorderThickness="1" Cursor="Hand" IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="OkButton" Content="Apply" Width="80" Height="32" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MxAccentForegroundBrush}" Background="{DynamicResource MxAccentBrush}" BorderThickness="0" Cursor="Hand" IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>