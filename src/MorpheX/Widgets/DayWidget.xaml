<Window
    x:Class="MorpheX.Widgets.DayWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MorpheX Day Widget"
    SizeToContent="WidthAndHeight"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="False"
    ResizeMode="NoResize">

    <Window.ContextMenu>
        <ContextMenu Background="#1A1A1E" BorderBrush="#30FFFFFF" Foreground="#FFFFFF" Padding="4">
            <MenuItem Header="🔡  Small" Click="SizeSmall_Click" Foreground="#AAFFFFFF"/>
            <MenuItem Header="🔡  Medium" Click="SizeMedium_Click" Foreground="#AAFFFFFF"/>
            <MenuItem Header="🔡  Large" Click="SizeLarge_Click" Foreground="#AAFFFFFF"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="⚪  White" Click="ColorWhite_Click" Foreground="#FFFFFF"/>
            <MenuItem Header="🔘  Dim White (50%)" Click="ColorDim_Click" Foreground="#88FFFFFF"/>
            <MenuItem Header="🔵  Cyan Glow" Click="ColorCyan_Click" Foreground="#38BDF8"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem x:Name="LockMenuItem" Header="🔒  Lock Position" Click="LockPosition_Click" Foreground="#FFD700"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="❌  Close Widget" Click="CloseWidget_Click" Foreground="#FF8888"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Pure floating text — no background, no border -->
    <TextBlock
        x:Name="DayText"
        Text="SUNDAY"
        FontSize="72"
        FontWeight="Light"
        FontFamily="Bahnschrift Light, Segoe UI Light, Segoe UI"
        Foreground="#CCFFFFFF"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Widget_MouseLeftButtonDown"
        Cursor="SizeAll"
        Margin="4,0"/>
</Window>
