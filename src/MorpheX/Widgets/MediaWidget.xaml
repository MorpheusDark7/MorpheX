<Window
    x:Class="MorpheX.Widgets.MediaWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MorpheX Audio Visualizer"
    Width="300" Height="130"
    MinWidth="240" MinHeight="110"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="False"
    ResizeMode="CanResizeWithGrip">

    <Window.ContextMenu>
        <ContextMenu Background="#1A1A1E" BorderBrush="#30FFFFFF" Foreground="#FFFFFF" Padding="4">
            <MenuItem Header="📊  Equalizer Bars" Click="StyleBars_Click" Foreground="#FFFFFF"/>
            <MenuItem Header="🪞  Mirrored Center" Click="StyleMirrored_Click" Foreground="#FFFFFF"/>
            <MenuItem Header="🌊  Waveform Curve" Click="StyleWaveform_Click" Foreground="#FFFFFF"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="⚪  Minimalist White" Click="ColorWhite_Click" Foreground="#FFFFFF"/>
            <MenuItem Header="🔵  Cyber Neon Cyan" Click="ColorCyan_Click" Foreground="#38BDF8"/>
            <MenuItem Header="🟣  Violet Glow" Click="ColorViolet_Click" Foreground="#C084FC"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem x:Name="LockMenuItem" Header="🔒  Lock Position" Click="LockPosition_Click" Foreground="#FFD700"/>
            <MenuItem Header="📐  Reset Size" Click="ResetSize_Click" Foreground="#AAFFFFFF"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="❌  Close Widget" Click="CloseWidget_Click" Foreground="#FF8888"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <DropShadowEffect x:Key="WidgetShadow" BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.6"/>
    </Window.Resources>

    <Border
        Margin="8"
        CornerRadius="14"
        Background="#D90E0E10"
        BorderBrush="#25FFFFFF"
        BorderThickness="1"
        Effect="{StaticResource WidgetShadow}"
        MouseLeftButtonDown="Widget_MouseLeftButtonDown"
        Cursor="SizeAll">

        <Grid Margin="14,10,14,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- Visualizer fills ALL remaining vertical space -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header + Live Indicator -->
            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <TextBlock
                    Text="NOW PLAYING"
                    FontSize="9"
                    FontWeight="Bold"
                    FontFamily="Segoe UI"
                    Foreground="#77FFFFFF"
                    VerticalAlignment="Center"/>
                <Ellipse
                    x:Name="LiveIndicator"
                    Width="6" Height="6"
                    Fill="#555555"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Row 1: Track Title & Artist -->
            <StackPanel Grid.Row="1" Margin="0,0,0,6">
                <TextBlock
                    x:Name="TrackTitleText"
                    Text="No Media Playing"
                    FontSize="12"
                    FontWeight="SemiBold"
                    FontFamily="Segoe UI"
                    Foreground="#FFFFFF"
                    TextTrimming="CharacterEllipsis"/>
                <TextBlock
                    x:Name="TrackArtistText"
                    Text="Windows Audio"
                    FontSize="10"
                    FontFamily="Segoe UI"
                    Foreground="#88FFFFFF"
                    TextTrimming="CharacterEllipsis"
                    Margin="0,1,0,0"/>
            </StackPanel>

            <!-- Row 2: Media Playback Controls -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                <!-- Previous Track -->
                <Button x:Name="PrevBtn"
                    Content="⏮"
                    FontSize="11"
                    Width="28" Height="24"
                    Background="#1EFFFFFF"
                    Foreground="#FFFFFF"
                    BorderThickness="1"
                    BorderBrush="#25FFFFFF"
                    Cursor="Hand"
                    Margin="0,0,5,0"
                    Click="PrevBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#35FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Play / Pause -->
                <Button x:Name="PlayPauseBtn"
                    Content="⏯"
                    FontSize="11"
                    Width="32" Height="24"
                    Background="#2AFFFFFF"
                    Foreground="#FFFFFF"
                    BorderThickness="1"
                    BorderBrush="#35FFFFFF"
                    Cursor="Hand"
                    Margin="0,0,5,0"
                    Click="PlayPauseBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#45FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#65FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Next Track -->
                <Button x:Name="NextBtn"
                    Content="⏭"
                    FontSize="11"
                    Width="28" Height="24"
                    Background="#1EFFFFFF"
                    Foreground="#FFFFFF"
                    BorderThickness="1"
                    BorderBrush="#25FFFFFF"
                    Cursor="Hand"
                    Click="NextBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#35FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Row 3: Audio Visualizer — stretches to fill all remaining space -->
            <Grid Grid.Row="3" x:Name="VisualizerContainer"
                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                  ClipToBounds="True" MinHeight="16">
                <UniformGrid x:Name="BarsGrid" Rows="1"
                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                <Path x:Name="WavePath" StrokeThickness="2.5"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      VerticalAlignment="Stretch" Visibility="Collapsed"/>
            </Grid>

        </Grid>
    </Border>
</Window>
