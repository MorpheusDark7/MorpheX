<Window
    x:Class="MorpheX.Widgets.MediaWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MorpheX Audio Visualizer"
    Width="300" Height="130"
    MinWidth="240" MinHeight="110"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="False"
    ResizeMode="CanResizeWithGrip">

    <Window.ContextMenu>
        <ContextMenu Background="#1A1A1E" BorderBrush="#30FFFFFF" Foreground="#FFFFFF" Padding="4">
            <MenuItem x:Name="ToggleCardMenu" Header="🔲  Show Background Card" Click="ToggleCard_Click" Foreground="#FFFFFF"/>
            <MenuItem x:Name="ToggleDetailsMenu" Header="🎵  Show Track Details" Click="ToggleDetails_Click" Foreground="#FFFFFF"/>
            <MenuItem x:Name="ToggleGlowMenu" Header="✨  Toggle Glow Effect" Click="ToggleGlow_Click" Foreground="#FFFFFF"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="📊  Equalizer Bars" Click="StyleBars_Click" Foreground="#FFFFFF"/>
            <MenuItem Header="🪞  Mirrored Center" Click="StyleMirrored_Click" Foreground="#FFFFFF"/>
            <MenuItem Header="🌊  Waveform Curve" Click="StyleWaveform_Click" Foreground="#FFFFFF"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="🎨  Color Theme">
                <MenuItem Header="⚪  Minimalist White" Click="ColorWhite_Click" Foreground="#FFFFFF"/>
                <MenuItem Header="🔵  Cyber Neon Cyan" Click="ColorCyan_Click" Foreground="#38BDF8"/>
                <MenuItem Header="🟣  Violet Glow" Click="ColorViolet_Click" Foreground="#C084FC"/>
                <MenuItem Header="🟢  Emerald Mint" Click="ColorMint_Click" Foreground="#4ADE80"/>
                <MenuItem Header="🟠  Sunset Amber" Click="ColorAmber_Click" Foreground="#FB923C"/>
            </MenuItem>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem x:Name="LockMenuItem" Header="🔒  Lock Position" Click="LockPosition_Click" Foreground="#FFD700"/>
            <MenuItem Header="📐  Reset Size" Click="ResetSize_Click" Foreground="#AAFFFFFF"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="❌  Close Widget" Click="CloseWidget_Click" Foreground="#FF8888"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <DropShadowEffect x:Key="WidgetShadow" BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.6"/>
        <DropShadowEffect x:Key="BarGlow" BlurRadius="10" ShadowDepth="0" Color="#FFFFFF" Opacity="0.55"/>

        <!-- Gradient brush for bars: teal bottom → white top -->
        <LinearGradientBrush x:Key="BarBrushWhite" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Color="#4038BDF8" Offset="0"/>
            <GradientStop Color="#BBFFFFFF" Offset="0.55"/>
            <GradientStop Color="#FFFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BarBrushCyan" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Color="#400EA5E8" Offset="0"/>
            <GradientStop Color="#CC38BDF8" Offset="0.5"/>
            <GradientStop Color="#FF7EE8FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BarBrushViolet" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Color="#406D28D9" Offset="0"/>
            <GradientStop Color="#CCA855F7" Offset="0.5"/>
            <GradientStop Color="#FFE0AAFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BarBrushMint" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Color="#40059669" Offset="0"/>
            <GradientStop Color="#CC34D399" Offset="0.5"/>
            <GradientStop Color="#FFA7F3D0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BarBrushAmber" StartPoint="0.5,1" EndPoint="0.5,0">
            <GradientStop Color="#40EA580C" Offset="0"/>
            <GradientStop Color="#CCFB923C" Offset="0.5"/>
            <GradientStop Color="#FFFDE047" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="IdleBrush" Color="#28FFFFFF"/>
    </Window.Resources>

    <Border
        x:Name="MainCardBorder"
        Margin="8"
        CornerRadius="14"
        Background="#D90E0E10"
        BorderBrush="#25FFFFFF"
        BorderThickness="1"
        Effect="{StaticResource WidgetShadow}"
        MouseLeftButtonDown="Widget_MouseLeftButtonDown"
        Cursor="SizeAll">

        <Grid x:Name="RootGrid" Margin="14,10,14,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- Visualizer fills ALL remaining vertical space -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header + Live Indicator -->
            <DockPanel x:Name="HeaderRow" Grid.Row="0" Margin="0,0,0,4">
                <TextBlock
                    Text="NOW PLAYING"
                    FontSize="9"
                    FontWeight="Bold"
                    FontFamily="Segoe UI"
                    Foreground="#77FFFFFF"
                    VerticalAlignment="Center"/>
                <Ellipse
                    x:Name="LiveIndicator"
                    Width="6" Height="6"
                    Fill="#555555"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Row 1: Track Title & Artist -->
            <StackPanel x:Name="TrackInfoRow" Grid.Row="1" Margin="0,0,0,6">
                <TextBlock
                    x:Name="TrackTitleText"
                    Text="No Media Playing"
                    FontSize="12"
                    FontWeight="SemiBold"
                    FontFamily="Segoe UI"
                    Foreground="#FFFFFF"
                    TextTrimming="CharacterEllipsis"/>
                <TextBlock
                    x:Name="TrackArtistText"
                    Text="Windows Audio"
                    FontSize="10"
                    FontFamily="Segoe UI"
                    Foreground="#88FFFFFF"
                    TextTrimming="CharacterEllipsis"
                    Margin="0,1,0,0"/>
            </StackPanel>

            <!-- Row 2: Media Playback Controls -->
            <StackPanel x:Name="ControlsRow" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                <!-- Previous Track -->
                <Button x:Name="PrevBtn"
                    Content="⏮"
                    FontSize="11"
                    Width="28" Height="24"
                    Background="#1EFFFFFF"
                    Foreground="#FFFFFF"
                    BorderThickness="1"
                    BorderBrush="#25FFFFFF"
                    Cursor="Hand"
                    Margin="0,0,5,0"
                    Click="PrevBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#35FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Play / Pause -->
                <Button x:Name="PlayPauseBtn"
                    Content="⏯"
                    FontSize="11"
                    Width="32" Height="24"
                    Background="#2AFFFFFF"
                    Foreground="#FFFFFF"
                    BorderThickness="1"
                    BorderBrush="#35FFFFFF"
                    Cursor="Hand"
                    Margin="0,0,5,0"
                    Click="PlayPauseBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#45FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#65FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Next Track -->
                <Button x:Name="NextBtn"
                    Content="⏭"
                    FontSize="11"
                    Width="28" Height="24"
                    Background="#1EFFFFFF"
                    Foreground="#FFFFFF"
                    BorderThickness="1"
                    BorderBrush="#25FFFFFF"
                    Cursor="Hand"
                    Click="NextBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#35FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Row 3: Audio Visualizer — stretches to fill all remaining space -->
            <Grid Grid.Row="3" x:Name="VisualizerContainer"
                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                  ClipToBounds="True" MinHeight="20">

                <!-- Subtle floor line -->
                <Rectangle Height="1" VerticalAlignment="Bottom"
                           Fill="#18FFFFFF" Margin="0,0,0,0"/>

                <UniformGrid x:Name="BarsGrid" Rows="1"
                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                             Margin="0,2,0,2"/>

                <!-- Waveform path -->
                <Path x:Name="WavePath" StrokeThickness="2"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      VerticalAlignment="Stretch" Visibility="Collapsed"/>
            </Grid>

        </Grid>
    </Border>
</Window>
