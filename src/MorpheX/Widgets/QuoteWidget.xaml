<Window
    x:Class="MorpheX.Widgets.QuoteWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MorpheX Quote"
    SizeToContent="WidthAndHeight"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="False"
    ResizeMode="NoResize">

    <Window.ContextMenu>
        <ContextMenu Background="#1A1A1E" BorderBrush="#30FFFFFF" Foreground="#FFFFFF" Padding="4">
            <MenuItem Header="Next Quote" Click="NextQuote_Click" Foreground="#FFFFFF"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem x:Name="ToggleCardMenu" Header="Show Background Card" Click="ToggleCard_Click" Foreground="#FFFFFF"/>
            <MenuItem Header="Color Theme" Foreground="#FFFFFF">
                <MenuItem Header="Minimalist White" Click="ColorPreset_Click" Tag="0"/>
                <MenuItem Header="Neon Cyan" Click="ColorPreset_Click" Tag="1"/>
                <MenuItem Header="Emerald Mint" Click="ColorPreset_Click" Tag="2"/>
                <MenuItem Header="Cyber Violet" Click="ColorPreset_Click" Tag="3"/>
                <MenuItem Header="Sunset Amber" Click="ColorPreset_Click" Tag="4"/>
                <MenuItem Header="Rose Pink" Click="ColorPreset_Click" Tag="5"/>
            </MenuItem>
            <MenuItem Header="Font Size" Foreground="#FFFFFF">
                <MenuItem Header="Small (11px)" Click="SizePreset_Click" Tag="0"/>
                <MenuItem Header="Normal (13px)" Click="SizePreset_Click" Tag="1"/>
                <MenuItem Header="Large (16px)" Click="SizePreset_Click" Tag="2"/>
            </MenuItem>
            <MenuItem Header="Font Style" Foreground="#FFFFFF">
                <MenuItem Header="Georgia Serif" Click="FontPreset_Click" Tag="0"/>
                <MenuItem Header="Segoe UI" Click="FontPreset_Click" Tag="1"/>
                <MenuItem Header="Bahnschrift Light" Click="FontPreset_Click" Tag="2"/>
            </MenuItem>
            <MenuItem Header="Opacity" Foreground="#FFFFFF">
                <MenuItem Header="100%" Click="Opacity_Click" Tag="1.0"/>
                <MenuItem Header="85%" Click="Opacity_Click" Tag="0.85"/>
                <MenuItem Header="70%" Click="Opacity_Click" Tag="0.70"/>
                <MenuItem Header="50%" Click="Opacity_Click" Tag="0.50"/>
            </MenuItem>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="Reload Widget" Click="ReloadWidget_Click" Foreground="#38BDF8"/>
            <MenuItem x:Name="LockMenuItem" Header="Lock Position" Click="LockPosition_Click" Foreground="#FFD700"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="Close Widget" Click="CloseWidget_Click" Foreground="#FF8888"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <DropShadowEffect x:Key="Glow" BlurRadius="18" ShadowDepth="0" Color="#000000" Opacity="0.55"/>
    </Window.Resources>

    <Border
        x:Name="CardBorder"
        Margin="6"
        CornerRadius="12"
        Background="#B8101013"
        MaxWidth="260"
        Effect="{StaticResource Glow}"
        MouseLeftButtonDown="Widget_MouseLeftButtonDown"
        Cursor="SizeAll">

        <StackPanel Margin="16,14,16,14">

            <!-- Quote mark decorative -->
            <TextBlock
                x:Name="QuoteMarkText"
                Text="&#x201C;"
                FontSize="28"
                FontFamily="Georgia, Times New Roman"
                Foreground="#33FFFFFF"
                Margin="0,-8,0,-10"
                HorizontalAlignment="Left"/>

            <!-- Quote text -->
            <TextBlock
                x:Name="QuoteText"
                Text=""
                TextWrapping="Wrap"
                FontSize="12"
                FontWeight="Light"
                FontFamily="Segoe UI Light, Segoe UI"
                Foreground="#CCFFFFFF"
                LineHeight="18"
                Margin="0,0,0,8"/>

            <!-- Author -->
            <TextBlock
                x:Name="AuthorText"
                Text=""
                FontSize="10"
                FontStyle="Italic"
                FontFamily="Segoe UI"
                Foreground="#66FFFFFF"
                HorizontalAlignment="Right"/>

        </StackPanel>
    </Border>
</Window>
