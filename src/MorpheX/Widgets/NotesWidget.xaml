<Window
    x:Class="MorpheX.Widgets.NotesWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MorpheX Notes"
    Width="220" Height="160"
    MinWidth="140" MinHeight="100"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="False"
    ResizeMode="CanResizeWithGrip">

    <Window.ContextMenu>
        <ContextMenu Background="#1A1A1E" BorderBrush="#30FFFFFF" Foreground="#FFFFFF" Padding="4">
            <MenuItem Header="📝  Notes" IsEnabled="False" Foreground="#88FFFFFF"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem x:Name="LockMenuItem" Header="🔒  Lock Position" Click="LockPosition_Click" Foreground="#FFD700"/>
            <MenuItem Header="📐  Reset Size" Click="ResetSize_Click" Foreground="#AAFFFFFF"/>
            <Separator Background="#25FFFFFF" Margin="0,4"/>
            <MenuItem Header="❌  Close Widget" Click="CloseWidget_Click" Foreground="#FF8888"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <DropShadowEffect x:Key="Glow" BlurRadius="18" ShadowDepth="0" Color="#000000" Opacity="0.55"/>
    </Window.Resources>

    <Border
        x:Name="CardBorder"
        Margin="6"
        CornerRadius="12"
        Background="#B8101013"
        Effect="{StaticResource Glow}"
        MouseLeftButtonDown="Header_MouseLeftButtonDown"
        Cursor="SizeAll">

        <Grid Margin="14,10,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header row -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock
                    Text="NOTES"
                    FontSize="9" FontWeight="Bold"
                    FontFamily="Segoe UI"
                    Foreground="#66FFFFFF"
                    VerticalAlignment="Center"/>
                <TextBlock
                    Text="✏️"
                    FontSize="10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Opacity="0.5"/>
            </DockPanel>

            <!-- Editable text area -->
            <TextBox
                x:Name="NoteText"
                Grid.Row="1"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                VerticalScrollBarVisibility="Auto"
                Background="Transparent"
                Foreground="#DDFFFFFF"
                CaretBrush="#AAFFFFFF"
                BorderThickness="0"
                FontSize="12"
                FontFamily="Segoe UI Light, Segoe UI"
                FontWeight="Light"
                VerticalAlignment="Stretch"
                Cursor="IBeam"
                Padding="0"
                TextChanged="NoteText_Changed"
                MouseLeftButtonDown="NoteArea_MouseLeftButtonDown">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="False">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Grid>
    </Border>
</Window>
