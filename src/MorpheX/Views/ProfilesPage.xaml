<Page
    x:Class="MorpheX.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,32">
        <StackPanel MaxWidth="840">

            <!-- ── Header ──────────────────────────────────────── -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        Text="Desktop Profiles"
                        Style="{StaticResource PageTitleStyle}"
                        Margin="0,0,0,2" />
                    <TextBlock
                        Text="Save and switch between your favorite wallpaper and widget layouts in one click."
                        Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button
                        x:Name="SaveCurrentSetupBtn"
                        Content="Save Current Setup"
                        Icon="{ui:SymbolIcon Save24}"
                        Appearance="Secondary"
                        Click="SaveCurrentSetupBtn_Click"
                        Margin="0,0,8,0" />
                    <ui:Button
                        x:Name="NewProfileBtn"
                        Content="New Profile"
                        Icon="{ui:SymbolIcon Add24}"
                        Appearance="Primary"
                        Click="NewProfileBtn_Click" />
                </StackPanel>
            </Grid>

            <!-- ── Active Profile Hero Card ────────────────────── -->
            <Border
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="#4038BDF8"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20,16"
                Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <Border Background="#10B981" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                <TextBlock Text="ACTIVE PROFILE" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <TextBlock
                                x:Name="ActiveProfileNameText"
                                Text="Default Setup"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="ActiveProfileSummaryText"
                            Text="Includes wallpapers and widgets snapshot."
                            FontSize="12"
                            Opacity="0.7"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button
                            x:Name="QuickRenameBtn"
                            Content="Rename"
                            Icon="{ui:SymbolIcon Edit24}"
                            Appearance="Secondary"
                            Click="QuickRenameBtn_Click"
                            Margin="0,0,8,0" />
                        <ui:Button
                            x:Name="QuickUpdateBtn"
                            Content="Update with Live Setup"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            Appearance="Primary"
                            Click="QuickUpdateBtn_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Profiles List Header ────────────────────────── -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="ALL SAVED PROFILES" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                <TextBlock
                    x:Name="ProfileCountText"
                    Text="1 profile"
                    FontSize="12"
                    Opacity="0.6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- ── Profiles Cards Container ────────────────────── -->
            <StackPanel x:Name="ProfilesContainer" Margin="0,0,0,24" />

            <!-- ── Tips & Help Card ────────────────────────────── -->
            <Border
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,14">
                <StackPanel>
                    <TextBlock Text="💡  Profile Pro-Tips" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,4" />
                    <TextBlock
                        Text="• Right-click the MorpheX tray icon anytime to switch desktop profiles without opening this window.&#x0a;• Tweak your widgets or change wallpapers, then hit 'Update with Live Setup' to save changes to the active profile.&#x0a;• Missing or deleted wallpapers are skipped gracefully so switching profiles is always fast and crash-proof."
                        Style="{StaticResource SettingDescriptionStyle}"
                        LineHeight="18" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
