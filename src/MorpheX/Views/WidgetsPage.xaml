<Page
    x:Class="MorpheX.WidgetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Widgets">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32" MaxWidth="680">

            <!-- Page Title -->
            <TextBlock Text="Widgets" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock
                Text="Transparent desktop overlays — drag to reposition, right-click for options."
                Style="{StaticResource PageSubtitleStyle}"
                Margin="0,4,0,0"/>

            <!-- Lock All Widgets ─────────────────────────────────── -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="#40FFD700"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="🔒  Lock Widget Positions" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="Prevent widgets from being accidentally dragged. Right-click any widget to unlock." Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch
                        x:Name="LockWidgetsToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Checked="LockWidgetsToggle_Changed"
                        Unchecked="LockWidgetsToggle_Changed"/>
                </Grid>
            </Border>

            <!-- ─── CLOCK ──────────────────────────────────────── -->
            <TextBlock Text="CLOCK" Style="{StaticResource SectionHeaderStyle}"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Floating Clock" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="Large HH:MM with date below — pure transparent text, no box." Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="ClockToggle" Grid.Column="1" VerticalAlignment="Center"
                        Checked="ClockToggle_Changed" Unchecked="ClockToggle_Changed"/>
                </Grid>
            </Border>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="24-Hour Format" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="Toggle 24h (23:54) vs 12h (11:54 PM). Double-click the widget to switch quickly." Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="ClockFormatToggle" Grid.Column="1" VerticalAlignment="Center"
                        Checked="ClockFormatToggle_Changed" Unchecked="ClockFormatToggle_Changed"/>
                </Grid>
            </Border>

            <!-- ─── DAY NAME ────────────────────────────────────── -->
            <TextBlock Text="DAY NAME" Style="{StaticResource SectionHeaderStyle}"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Large Day Name" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text='Big "SUNDAY" style floating text. Right-click to change size and colour.' Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="DayToggle" Grid.Column="1" VerticalAlignment="Center"
                        Checked="DayToggle_Changed" Unchecked="DayToggle_Changed"/>
                </Grid>
            </Border>

            <!-- ─── CALENDAR ─────────────────────────────────────── -->
            <TextBlock Text="CALENDAR" Style="{StaticResource SectionHeaderStyle}"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Monthly Calendar" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="Shows current month with today highlighted. Minimal dark frosted card." Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="CalendarToggle" Grid.Column="1" VerticalAlignment="Center"
                        Checked="CalendarToggle_Changed" Unchecked="CalendarToggle_Changed"/>
                </Grid>
            </Border>

            <!-- ─── SYSTEM MONITOR ───────────────────────────────── -->
            <TextBlock Text="SYSTEM MONITOR" Style="{StaticResource SectionHeaderStyle}"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="CPU / GPU / RAM Circles" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="Horizontal row of circular dials — no box, pure floating indicators." Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="SysMonToggle" Grid.Column="1" VerticalAlignment="Center"
                        Checked="SysMonToggle_Changed" Unchecked="SysMonToggle_Changed"/>
                </Grid>
            </Border>

            <!-- ─── AUDIO VISUALIZER ─────────────────────────────── -->
            <TextBlock Text="AUDIO VISUALIZER &amp; MEDIA" Style="{StaticResource SectionHeaderStyle}"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Audio Visualizer &amp; Now Playing" Style="{StaticResource SettingLabelStyle}"/>
                            <TextBlock Text="Live equalizer bars, track info (Spotify, YouTube, etc.), media controls. Resize from corner." Style="{StaticResource SettingDescriptionStyle}"/>
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="MediaToggle" Grid.Column="1" VerticalAlignment="Center"
                            Checked="MediaToggle_Changed" Unchecked="MediaToggle_Changed"/>
                    </Grid>

                    <!-- Visualizer Style + Color -->
                    <Border BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Visualizer Style" FontSize="11" Foreground="#AAFFFFFF" Margin="0,0,0,4"/>
                                <ComboBox x:Name="VisualizerStyleCombo" SelectionChanged="VisualizerStyleCombo_SelectionChanged">
                                    <ComboBoxItem Content="📊  Equalizer Bars" Tag="0"/>
                                    <ComboBoxItem Content="🪞  Mirrored Center" Tag="1"/>
                                    <ComboBoxItem Content="🌊  Waveform Curve" Tag="2"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Color Theme" FontSize="11" Foreground="#AAFFFFFF" Margin="0,0,0,4"/>
                                <ComboBox x:Name="VisualizerColorCombo" SelectionChanged="VisualizerColorCombo_SelectionChanged">
                                    <ComboBoxItem Content="⚪  Minimalist White" Tag="0"/>
                                    <ComboBoxItem Content="🔵  Cyber Neon Cyan" Tag="1"/>
                                    <ComboBoxItem Content="🟣  Violet Glow" Tag="2"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ─── NOTES ─────────────────────────────────────────── -->
            <TextBlock Text="NOTES" Style="{StaticResource SectionHeaderStyle}"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Sticky Notes" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="Editable text on your desktop. Resize from the corner. Text saves automatically." Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="NotesToggle" Grid.Column="1" VerticalAlignment="Center"
                        Checked="NotesToggle_Changed" Unchecked="NotesToggle_Changed"/>
                </Grid>
            </Border>

            <!-- ─── QUOTE ─────────────────────────────────────────── -->
            <TextBlock Text="DAILY QUOTE" Style="{StaticResource SectionHeaderStyle}"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Motivational Quote" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="A floating quote card. Double-click or right-click to cycle quotes." Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="QuoteToggle" Grid.Column="1" VerticalAlignment="Center"
                        Checked="QuoteToggle_Changed" Unchecked="QuoteToggle_Changed"/>
                </Grid>
            </Border>

            <!-- ─── TIPS ──────────────────────────────────────────── -->
            <Border Background="#0A38BDF8" BorderBrush="#1A38BDF8" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="💡  Tips" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#AAFFFFFF" LineHeight="18">
                        <Run>• Drag any widget to reposition — position saves automatically.</Run>
                        <LineBreak/>
                        <Run>• Right-click any widget to Lock/Unlock, change size/colour, or close.</Run>
                        <LineBreak/>
                        <Run>• Double-click Clock or Quote widget for quick actions.</Run>
                        <LineBreak/>
                        <Run>• Audio Visualizer and Notes are resizable from the corner.</Run>
                        <LineBreak/>
                        <Run>• Widgets float above the wallpaper, behind all app windows.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
