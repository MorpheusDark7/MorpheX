                                                  Checked="WeatherOption_Changed" Unchecked="WeatherOption_Changed"/>
                                        <CheckBox x:Name="WeatherCardBgCheck" Content="Frosted Background Card" Margin="0,0,0,8"
                                                  Checked="WeatherOption_Changed" Unchecked="WeatherOption_Changed"/>
