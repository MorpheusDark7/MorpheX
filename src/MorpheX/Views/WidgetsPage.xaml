                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Live temperature, conditions, humidity, and wind. Powered by free Open-Meteo. Refreshes every 30 min." Style="{StaticResource SettingDescriptionStyle}"/>
