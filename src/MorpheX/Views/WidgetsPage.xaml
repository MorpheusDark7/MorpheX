<Page
    x:Class="MorpheX.WidgetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Widgets">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32" MaxWidth="680">

            <!-- Page Title -->
            <TextBlock Text="Widgets" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock
                Text="Transparent desktop overlays. Drag any widget to reposition it."
                Style="{StaticResource PageSubtitleStyle}"
                Margin="0,4,0,0"/>

            <!-- CLOCK ─────────────────────────────────────────────── -->
            <TextBlock Text="CLOCK" Style="{StaticResource SectionHeaderStyle}"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Clock &amp; Date" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="Shows current time and date on the desktop." Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch
                        x:Name="ClockToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Checked="ClockToggle_Changed"
                        Unchecked="ClockToggle_Changed"/>
                </Grid>
            </Border>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="24-Hour Time Format" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="Toggle between 24-hour (18:43) and 12-hour (6:43 PM). You can also double-click the clock widget." Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch
                        x:Name="ClockFormatToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Checked="ClockFormatToggle_Changed"
                        Unchecked="ClockFormatToggle_Changed"/>
                </Grid>
            </Border>

            <!-- SYSTEM MONITOR ───────────────────────────────────── -->
            <TextBlock Text="SYSTEM MONITOR" Style="{StaticResource SectionHeaderStyle}"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="CPU / GPU / RAM (Circle Dials)" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="Minimalist black &amp; white circular dials showing live CPU, GPU, and RAM usage." Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch
                        x:Name="SysMonToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Checked="SysMonToggle_Changed"
                        Unchecked="SysMonToggle_Changed"/>
                </Grid>
            </Border>

            <!-- MEDIA ────────────────────────────────────────────── -->
            <TextBlock Text="AUDIO VISUALIZER &amp; MEDIA" Style="{StaticResource SectionHeaderStyle}"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Audio Visualizer &amp; Now Playing" Style="{StaticResource SettingLabelStyle}"/>
                            <TextBlock Text="Live equalizer bars, track info (Spotify, YouTube, etc.), and media controls. Drag to move, resize from the corner." Style="{StaticResource SettingDescriptionStyle}"/>
                        </StackPanel>
                        <ui:ToggleSwitch
                            x:Name="MediaToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Checked="MediaToggle_Changed"
                            Unchecked="MediaToggle_Changed"/>
                    </Grid>

                    <!-- Visualizer Customization Options -->
                    <Border BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Style selector -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Visualizer Style" FontSize="11" Foreground="#AAFFFFFF" Margin="0,0,0,4"/>
                                <ComboBox x:Name="VisualizerStyleCombo" SelectionChanged="VisualizerStyleCombo_SelectionChanged">
                                    <ComboBoxItem Content="📊  Equalizer Bars" Tag="0"/>
                                    <ComboBoxItem Content="🪞  Mirrored Center" Tag="1"/>
                                    <ComboBoxItem Content="🌊  Waveform Curve" Tag="2"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Color selector -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Color Theme" FontSize="11" Foreground="#AAFFFFFF" Margin="0,0,0,4"/>
                                <ComboBox x:Name="VisualizerColorCombo" SelectionChanged="VisualizerColorCombo_SelectionChanged">
                                    <ComboBoxItem Content="⚪  Minimalist White" Tag="0"/>
                                    <ComboBoxItem Content="🔵  Cyber Neon Cyan" Tag="1"/>
                                    <ComboBoxItem Content="🟣  Violet Glow" Tag="2"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- TIPS ─────────────────────────────────────────────── -->
            <Border Background="#0A38BDF8" BorderBrush="#1A38BDF8" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="💡  Tips" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#AAFFFFFF" LineHeight="18">
                        <Run>• Drag any widget to reposition it — position is saved automatically.</Run>
                        <LineBreak/>
                        <Run>• Audio Visualizer can be resized by dragging the bottom-right corner.</Run>
                        <LineBreak/>
                        <Run>• Double-click the Clock widget to quickly switch between 12h and 24h.</Run>
                        <LineBreak/>
                        <Run>• Widgets sit behind your app windows, above the wallpaper.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>


