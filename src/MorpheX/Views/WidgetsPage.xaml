                                            Padding="12,6"
                                            Click="WeatherAutoDetectBtn_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Location24" Margin="0,0,6,0" FontSize="13"/>
                                            <TextBlock Text="Auto-Detect"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

