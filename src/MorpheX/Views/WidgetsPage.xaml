<Page
    x:Class="MorpheX.WidgetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Widgets">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32" MaxWidth="680">

            <!-- Page Title -->
            <TextBlock Text="Widgets" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock
                Text="Transparent desktop overlays. Drag any widget to reposition it."
                Style="{StaticResource PageSubtitleStyle}"
                Margin="0,4,0,0"/>

            <!-- CLOCK ─────────────────────────────────────────────── -->
            <TextBlock Text="CLOCK" Style="{StaticResource SectionHeaderStyle}"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Clock &amp; Date" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="Shows current time and date on the desktop." Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch
                        x:Name="ClockToggle"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Checked="ClockToggle_Changed"
                        Unchecked="ClockToggle_Changed"/>
                </Grid>
            </Border>

            <!-- SYSTEM MONITOR ───────────────────────────────────── -->
            <TextBlock Text="SYSTEM MONITOR" Style="{StaticResource SectionHeaderStyle}"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="CPU / GPU / RAM" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="Live system resource usage with progress bars. Reuses existing polling — no extra CPU cost." Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch
                        x:Name="SysMonToggle"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Checked="SysMonToggle_Changed"
                        Unchecked="SysMonToggle_Changed"/>
                </Grid>
            </Border>

            <!-- MEDIA ────────────────────────────────────────────── -->
            <TextBlock Text="MEDIA CONTROLS" Style="{StaticResource SectionHeaderStyle}"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Now Playing" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBlock Text="Shows the active wallpaper name with pause and next controls." Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch
                        x:Name="MediaToggle"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Checked="MediaToggle_Changed"
                        Unchecked="MediaToggle_Changed"/>
                </Grid>
            </Border>

            <!-- TIPS ─────────────────────────────────────────────── -->
            <Border Background="#0A38BDF8" BorderBrush="#1A38BDF8" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="💡  Tips" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#AAFFFFFF" LineHeight="18">
                        <Run>• Drag any widget to reposition it — position is saved automatically.</Run>
                        <LineBreak/>
                        <Run>• Widgets sit behind all app windows and above the wallpaper.</Run>
                        <LineBreak/>
                        <Run>• All widgets are lightweight and designed for low-end hardware.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
