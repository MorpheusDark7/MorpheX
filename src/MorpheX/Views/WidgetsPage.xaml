<Page
    x:Class="MorpheX.WidgetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Widgets">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32" MaxWidth="680">

            <!-- Page Title -->
            <TextBlock Text="Widgets" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock
                Text="Transparent desktop overlays inspired by Rainmeter - drag to reposition, right-click for quick actions."
                Style="{StaticResource PageSubtitleStyle}"
                Margin="0,4,0,0"/>

            <!-- Desktop Profiles Link ─────────────────────────────── -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Desktop Profiles" Style="{StaticResource SettingLabelStyle}"/>
                        </StackPanel>
                        <TextBlock Text="Save and switch between complete wallpaper and widget presets." Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="Manage Profiles" Icon="{ui:SymbolIcon Layer24}" Appearance="Secondary" Click="OpenProfiles_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Lock All Widgets ─────────────────────────────────── -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="LockClosed24" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Lock Widget Positions" Style="{StaticResource SettingLabelStyle}"/>
                        </StackPanel>
                        <TextBlock Text="Pin all widgets in place so they cannot be accidentally moved." Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ui:ToggleSwitch
                        x:Name="LockWidgetsToggle"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Checked="LockWidgetsToggle_Changed"
                        Unchecked="LockWidgetsToggle_Changed"/>
                </Grid>
            </Border>

            <!-- Widget Theme / Appearance ─────────────────────────── -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Color24" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Widget Theme" Style="{StaticResource SettingLabelStyle}"/>
                        </StackPanel>
                        <TextBlock Text="Choose card styling. Dark (smoked glass) or Light (frosted ivory/cream) for brighter wallpapers." Style="{StaticResource SettingDescriptionStyle}"/>
                    </StackPanel>
                    <ComboBox x:Name="WidgetThemeCombo" Grid.Column="1" VerticalAlignment="Center" Width="160"
                              SelectionChanged="WidgetThemeCombo_Changed">
                        <ComboBoxItem Tag="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="14" Margin="0,0,8,0" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                <TextBlock Text="Dark Mode" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="14" Margin="0,0,8,0" Foreground="#FBBF24" VerticalAlignment="Center"/>
                                <TextBlock Text="Light Mode" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ─── CLOCK ──────────────────────────────────────── -->
            <TextBlock Text="CLOCK" Style="{StaticResource SectionHeaderStyle}"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Clock Widget" Style="{StaticResource SettingLabelStyle}"/>
                            <TextBlock Text="Clean time display without seconds. Double-click widget to flip 12h/24h." Style="{StaticResource SettingDescriptionStyle}"/>
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ClockToggle" Grid.Column="1" VerticalAlignment="Center"
                            Checked="ClockToggle_Changed" Unchecked="ClockToggle_Changed"/>
                    </Grid>

                    <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                <TextBlock Text="Size" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ClockSizeCombo" SelectionChanged="ClockSetting_Changed">
                                    <ComboBoxItem Content="Small (40px)" Tag="0"/>
                                    <ComboBoxItem Content="Medium (64px)" Tag="1"/>
                                    <ComboBoxItem Content="Large (88px)" Tag="2"/>
                                    <ComboBoxItem Content="Huge (112px)" Tag="3"/>
                                    <ComboBoxItem Content="Giant (140px)" Tag="4"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                <TextBlock Text="Color Theme" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ClockColorCombo" SelectionChanged="ClockSetting_Changed">

                                    <ComboBoxItem Tag="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#CCCCCC" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Pure White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8899AA" Offset="0"/><GradientStop Color="#445566" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Dim Slate" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#00FFFF" Offset="0"/><GradientStop Color="#007BFF" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Electric Cyan" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="3">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4CAF93" Offset="0"/><GradientStop Color="#1B6E55" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Neon Mint" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#BF7FFF" Offset="0"/><GradientStop Color="#7B2FBE" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Cyber Violet" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFB347" Offset="0"/><GradientStop Color="#E05C00" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Sunset Orange" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFE05A" Offset="0"/><GradientStop Color="#C8A800" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Amber Gold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="7">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#C4B5FD" Offset="0"/><GradientStop Color="#A78BFA" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Soft Lavender" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FDA4AF" Offset="0"/><GradientStop Color="#FB7185" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Rose Pink" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="9">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B4BEFE" Offset="0"/><GradientStop Color="#89B4FA" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Frost Sky" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FB7185" Offset="0"/><GradientStop Color="#F43F5E" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Crimson Red" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Font Style" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ClockFontCombo" SelectionChanged="ClockSetting_Changed">
                                    <ComboBoxItem Tag="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="24" Height="18" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="Aa" FontFamily="Bahnschrift Light" FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="Bahnschrift Light" FontFamily="Bahnschrift Light" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="24" Height="18" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="Aa" FontFamily="Segoe UI Light" FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="Segoe UI Light" FontFamily="Segoe UI Light" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="24" Height="18" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="08" FontFamily="pack://application:,,,/Resources/Fonts/#Anurati" FontSize="10"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="Anurati Numbers" FontFamily="pack://application:,,,/Resources/Fonts/#Anurati" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="3">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="24" Height="18" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="&gt;_" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="Consolas Monospace" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <CheckBox x:Name="ClockFormatCheck" Content="24-Hour Format" Margin="0,0,0,4" Checked="ClockOption_Changed" Unchecked="ClockOption_Changed"/>
                                <CheckBox x:Name="ClockDateCheck" Content="Show Date Below" Margin="0,0,0,4" Checked="ClockOption_Changed" Unchecked="ClockOption_Changed"/>
                                <CheckBox x:Name="ClockSecondsCheck" Content="Show Seconds" Margin="0,0,0,4" Checked="ClockOption_Changed" Unchecked="ClockOption_Changed"/>
                                <CheckBox x:Name="ClockGlowCheck" Content="Neon Glow" Margin="0,0,0,4" Checked="ClockOption_Changed" Unchecked="ClockOption_Changed"/>
                                <CheckBox x:Name="ClockCardCheck" Content="Frosted Background Card" Checked="ClockOption_Changed" Unchecked="ClockOption_Changed"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,8,0">
                                <TextBlock Text="Alignment" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ClockAlignmentCombo" SelectionChanged="ClockSetting_Changed">
                                    <ComboBoxItem Content="Left" Tag="0"/>
                                    <ComboBoxItem Content="Center" Tag="1"/>
                                    <ComboBoxItem Content="Right" Tag="2"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,8,0,0">
                                <TextBlock Text="Opacity" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ClockOpacityCombo" SelectionChanged="ClockSetting_Changed">
                                    <ComboBoxItem Content="100% (Solid)" Tag="100"/>
                                    <ComboBoxItem Content="90%" Tag="90"/>
                                    <ComboBoxItem Content="80%" Tag="80"/>
                                    <ComboBoxItem Content="70%" Tag="70"/>
                                    <ComboBoxItem Content="50% (Transparent)" Tag="50"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ─── DAY NAME ────────────────────────────────────── -->
            <TextBlock Text="DAY NAME (ANURATI &amp; MOND)" Style="{StaticResource SectionHeaderStyle}"/>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Large Weekday" Style="{StaticResource SettingLabelStyle}"/>
                            <TextBlock Text='Sci-fi geometric cutouts in Anurati font with kerning compensation for "FRIDAY".' Style="{StaticResource SettingDescriptionStyle}"/>
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="DayToggle" Grid.Column="1" VerticalAlignment="Center"
                            Checked="DayToggle_Changed" Unchecked="DayToggle_Changed"/>
                    </Grid>

                    <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                <TextBlock Text="Size" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="DaySizeCombo" SelectionChanged="DaySetting_Changed">
                                    <ComboBoxItem Content="Small (42px)" Tag="0"/>
                                    <ComboBoxItem Content="Medium (64px)" Tag="1"/>
                                    <ComboBoxItem Content="Large (86px)" Tag="2"/>
                                    <ComboBoxItem Content="Huge (110px)" Tag="3"/>
                                    <ComboBoxItem Content="Giant (140px)" Tag="4"/>
                                    <ComboBoxItem Content="Massive (180px)" Tag="5"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                <TextBlock Text="Color Theme" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="DayColorCombo" SelectionChanged="DaySetting_Changed">

                                    <ComboBoxItem Tag="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#CCCCCC" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Pure White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8899AA" Offset="0"/><GradientStop Color="#445566" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Dim Slate" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#00FFFF" Offset="0"/><GradientStop Color="#007BFF" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Electric Cyan" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="3">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4CAF93" Offset="0"/><GradientStop Color="#1B6E55" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Neon Mint" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#BF7FFF" Offset="0"/><GradientStop Color="#7B2FBE" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Cyber Violet" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="5">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFB347" Offset="0"/><GradientStop Color="#E05C00" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Sunset Orange" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFE05A" Offset="0"/><GradientStop Color="#C8A800" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Amber Gold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="7">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF7FAA" Offset="0"/><GradientStop Color="#D94080" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Rose Pink" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF4040" Offset="0"/><GradientStop Color="#A00000" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Crimson Red" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="9">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#C4B5FD" Offset="0"/><GradientStop Color="#A78BFA" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Soft Lavender" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <ComboBoxItem Tag="10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
