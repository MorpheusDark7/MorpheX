                                            <ComboBoxItem Content="80%" Tag="80"/>
                                            <ComboBoxItem Content="70%" Tag="70"/>
                                            <ComboBoxItem Content="50% (Transparent)" Tag="50"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#0A38BDF8" BorderBrush="#1A38BDF8" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,20,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:SymbolIcon Symbol="Lightbulb24" Margin="0,0,6,0" FontSize="14" Foreground="#38BDF8"/>
