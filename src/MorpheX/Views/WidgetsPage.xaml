                                    <!-- Equalizer Bars -->
                                    <ComboBoxItem Tag="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Canvas Width="22" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Rectangle Canvas.Left="0"  Canvas.Bottom="0" Width="3" Height="6"  Fill="#4CAF93" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="4"  Canvas.Bottom="0" Width="3" Height="11" Fill="#4CAF93" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="8"  Canvas.Bottom="0" Width="3" Height="15" Fill="#4CAF93" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="12" Canvas.Bottom="0" Width="3" Height="9"  Fill="#4CAF93" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="16" Canvas.Bottom="0" Width="3" Height="13" Fill="#4CAF93" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="20" Canvas.Bottom="0" Width="3" Height="7"  Fill="#4CAF93" RadiusX="1" RadiusY="1"/>
                                            </Canvas>
                                            <TextBlock Text="Equalizer Bars" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <!-- Mirrored Center -->
                                    <ComboBoxItem Tag="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Canvas Width="22" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Rectangle Canvas.Left="0"  Canvas.Bottom="8" Width="3" Height="5"  Fill="#7C9FFF" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="4"  Canvas.Bottom="8" Width="3" Height="8"  Fill="#7C9FFF" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="8"  Canvas.Bottom="8" Width="3" Height="7"  Fill="#7C9FFF" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="16" Canvas.Bottom="8" Width="3" Height="5"  Fill="#7C9FFF" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="12" Canvas.Bottom="8" Width="3" Height="8"  Fill="#7C9FFF" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="20" Canvas.Bottom="8" Width="3" Height="7"  Fill="#7C9FFF" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="0"  Canvas.Top="8"    Width="3" Height="5"  Fill="#7C9FFF" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="4"  Canvas.Top="8"    Width="3" Height="8"  Fill="#7C9FFF" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="8"  Canvas.Top="8"    Width="3" Height="7"  Fill="#7C9FFF" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="12" Canvas.Top="8"    Width="3" Height="8"  Fill="#7C9FFF" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="16" Canvas.Top="8"    Width="3" Height="5"  Fill="#7C9FFF" RadiusX="1" RadiusY="1"/>
                                                <Rectangle Canvas.Left="20" Canvas.Top="8"    Width="3" Height="7"  Fill="#7C9FFF" RadiusX="1" RadiusY="1"/>
                                                <Line X1="0" Y1="8" X2="23" Y2="8" Stroke="#50FFFFFF" StrokeThickness="1"/>
                                            </Canvas>
                                            <TextBlock Text="Mirrored Center" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ComboBoxItem>

                                    <!-- Waveform Curve -->
                                    <ComboBoxItem Tag="2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
