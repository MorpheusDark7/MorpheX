<Window
    x:Class="MorpheX.Views.ProfileNameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MorpheX Profile"
    Width="380"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False">

    <Border Margin="14" Background="#181824" CornerRadius="12" BorderBrush="#303046" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" Opacity="0.75" ShadowDepth="6"/>
        </Border.Effect>
        <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="20,16,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleLabel" Grid.Column="0" Text="Desktop Profile" FontSize="11" FontWeight="SemiBold" Foreground="#8A92A6" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Width="26" Height="26" FontSize="12" Foreground="#8A92A6" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Cancel_Click"/>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="20,0,20,16">
                <TextBlock x:Name="HeadingLabel" Text="Name your profile" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                <TextBlock x:Name="DescriptionLabel" Text="Save your current widget positions, styling, and desktop mood." FontSize="12" Foreground="#9099B0" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12"/>
                
                <TextBox x:Name="InputBox" MaxLength="28" FontSize="15" FontFamily="Segoe UI, Bahnschrift" Foreground="#FFFFFF" Background="#11111A" BorderBrush="#3B3B52" BorderThickness="1" Padding="10,8" CaretBrush="#38BDF8" SelectionBrush="#38BDF8" TextChanged="InputBox_TextChanged" KeyDown="InputBox_KeyDown"/>
                <TextBlock x:Name="CharCounter" Text="0 / 28" FontSize="10" Foreground="#606080" HorizontalAlignment="Right" Margin="0,4,0,8"/>

                <CheckBox x:Name="IncludeWallpaperCheck" Content="Include current wallpaper in this profile" IsChecked="True" Foreground="#CBD5E1" FontSize="12" Cursor="Hand"/>
            </StackPanel>

            <!-- Footer / Action Buttons -->
            <Border Grid.Row="2" Background="#14141E" CornerRadius="0,0,11,11" BorderBrush="#242436" BorderThickness="0,1,0,0" Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="84" Height="32" Margin="0,0,10,0" FontSize="13" Foreground="#94A3B8" Background="#222230" BorderBrush="#333348" BorderThickness="1" Cursor="Hand" IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="OkButton" Content="Save Profile" Width="100" Height="32" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Background="#38BDF8" BorderThickness="0" Cursor="Hand" IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
