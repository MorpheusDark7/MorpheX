<Page
    x:Class="MorpheX.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:MorpheX"
    Title="Favorites">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:ThumbnailImageConverter x:Key="ThumbnailConverter" />
    </Page.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                <ui:SymbolIcon
                    Symbol="Heart24"
                    FontSize="22"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Favorites" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock
                        x:Name="FavoriteCountText"
                        Text="0 favorites"
                        Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,20" />

        <ScrollViewer
            x:Name="WallpapersScroll"
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="FavoritesGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardAction
                            Style="{StaticResource WallpaperCardStyle}"
                            Tag="{Binding}"
                            Click="WallpaperCard_Click">
                            <ui:CardAction.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Apply as Wallpaper" Click="ContextMenu_Apply_Click">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Play24" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Remove from Favorites" Click="ContextMenu_RemoveFavorite_Click">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="HeartBroken24" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Info / Rename" Click="ContextMenu_Info_Click">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Info24" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Open File Location" Click="ContextMenu_OpenLocation_Click">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ui:CardAction.ContextMenu>

                            <Grid>
                                <!-- Background Image Thumbnail filling entire 16:9 card -->
                                <Border
                                    CornerRadius="10"
                                    ClipToBounds="True"
                                    Background="#111118">
                                    <Grid>
                                        <ui:SymbolIcon
                                            Symbol="Image24"
                                            FontSize="28"
                                            Foreground="#30FFFFFF"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <Image
                                            Source="{Binding PreviewImagePath, Converter={StaticResource ThumbnailConverter}}"
                                            Stretch="UniformToFill"
                                            RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>

                                <!-- Top Badges & Controls -->
                                <Grid VerticalAlignment="Top" Margin="8,8,8,0">
                                    <Border
                                        HorizontalAlignment="Left"
                                        Padding="7,3"
                                        CornerRadius="4"
                                        Background="{StaticResource MxActiveBadgeBrush}"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Checkmark12" Foreground="White" FontSize="10" Margin="0,0,4,0" />
                                            <TextBlock Text="ACTIVE" FontSize="9" FontWeight="Bold" Foreground="White" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button
                                            Width="26" Height="26"
                                            Margin="0,0,6,0"
                                            Cursor="Hand"
                                            PreviewMouseLeftButtonDown="FavoriteButton_PreviewMouseLeftButtonDown"
                                            Click="FavoriteButton_Click"
                                            ToolTip="Remove from Favorites">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="#99000000" CornerRadius="13" Width="26" Height="26">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <ui:SymbolIcon Symbol="Heart24" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </Button>

                                        <Border
                                            Padding="6,3"
                                            CornerRadius="4"
                                            Background="#99000000">
                                            <TextBlock Text="{Binding Type}" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Bottom Smoked-Glass Gradient Overlay with Title, Resolution, and ••• Menu Button -->
                                <Border
                                    VerticalAlignment="Bottom"
                                    Padding="10,14,8,8"
                                    CornerRadius="0,0,10,10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#CC09090D" Offset="0.38" />
                                            <GradientStop Color="#F009090D" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="#FFFFFF" />
                                            <TextBlock FontSize="10" Margin="0,2,0,0" Opacity="0.75" Foreground="#CBD5E1">
                                                <Run Text="{Binding Type, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding ResolutionText, Mode=OneWay, TargetNullValue='Auto'}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- ••• Card Context Menu Button -->
                                        <Button
                                            Grid.Column="1"
                                            Width="26" Height="26"
                                            Cursor="Hand"
                                            ToolTip="More Options"
                                            Click="CardMenuButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" Background="#55000000" CornerRadius="6" Width="26" Height="26">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource MxAccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14" Foreground="#FFFFFF" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ui:CardAction>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Visible">

            <Border
                Width="72" Height="72"
                CornerRadius="36"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <ui:SymbolIcon
                    Symbol="Heart24"
                    FontSize="28"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.85" />
            </Border>

            <TextBlock
                Text="No favorites yet"
                FontSize="17"
                FontWeight="Medium"
                HorizontalAlignment="Center"
                Margin="0,0,0,8"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock
                Text="Mark wallpapers as favorites in the Library&#x0a;to quickly access them here."
                FontSize="12"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="280"
                Opacity="0.55"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
