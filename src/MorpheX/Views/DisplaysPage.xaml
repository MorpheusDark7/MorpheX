<Page
    x:Class="MorpheX.DisplaysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Displays">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                <TextBlock
                    Text="Displays"
                    Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    x:Name="DisplaysCountText"
                    Text="Detecting displays..."
                    Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <ui:Button
                    Content="Identify"
                    Icon="{ui:SymbolIcon WindowDevTools24}"
                    Click="IdentifyButton_Click"
                    Margin="0,0,8,0" />
                <ui:Button
                    Content="Refresh"
                    Icon="{ui:SymbolIcon ArrowClockwise24}"
                    Click="RefreshButton_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,20" />

        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,16">
                <!-- Wallpaper Placement Mode Selector -->
                <ui:Card Margin="0,0,0,20" Padding="18,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Wallpaper Placement Mode" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Configure how wallpapers are distributed across your connected monitors"
                                           FontSize="12" Opacity="0.65" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Center" Padding="10,4" CornerRadius="6"
                                    Background="{DynamicResource MxAccentSubtleBrush}">
                                <TextBlock x:Name="ActiveModeBadgeText" Text="Per-Display" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MxAccentBrush}" />
                            </Border>
                        </Grid>

                        <!-- 3 Segmented Placement Mode Options -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Option 1: Per-Display -->
                            <Border x:Name="ModePerDisplayCard" Grid.Column="0"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1.5" CornerRadius="8" Padding="14,12" Cursor="Hand"
                                    MouseLeftButtonUp="PlacementMode_Click" Tag="PerDisplay">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="Desktop24" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Per-Display" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Individual wallpaper on each connected display." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.7" TextWrapping="Wrap" LineHeight="16" />
                                </StackPanel>
                            </Border>

                            <!-- Option 2: Duplicate -->
                            <Border x:Name="ModeDuplicateCard" Grid.Column="2"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1.5" CornerRadius="8" Padding="14,12" Cursor="Hand"
                                    MouseLeftButtonUp="PlacementMode_Click" Tag="Duplicate">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="Copy24" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Duplicate / Mirror" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Mirror active wallpaper across all connected displays." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.7" TextWrapping="Wrap" LineHeight="16" />
                                </StackPanel>
                            </Border>

                            <!-- Option 3: Span -->
                            <Border x:Name="ModeSpanCard" Grid.Column="4"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1.5" CornerRadius="8" Padding="14,12" Cursor="Hand"
                                    MouseLeftButtonUp="PlacementMode_Click" Tag="Span">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="SlideGrid24" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Span Screen" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Span a single widescreen wallpaper across all monitors." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.7" TextWrapping="Wrap" LineHeight="16" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Video Scaling Modes Card -->
                <ui:Card Margin="0,0,0,20" Padding="18,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Video Scaling Modes for Live Wallpaper" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Distinct scaling options to ensure custom video wallpapers render correctly across various screen aspect ratios without visual distortion."
                                           FontSize="12" Opacity="0.65" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Center" Padding="10,4" CornerRadius="6"
                                    Background="{DynamicResource MxAccentSubtleBrush}">
                                <TextBlock x:Name="ActiveScalingBadgeText" Text="Crop to Center" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MxAccentBrush}" />
                            </Border>
                        </Grid>

                        <!-- 3 Segmented Scaling Mode Options -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Option 1: Crop to Center (Fill) -->
                            <Border x:Name="ScalingCropCard" Grid.Column="0"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1.5" CornerRadius="8" Padding="14,12" Cursor="Hand"
                                    MouseLeftButtonUp="ScalingMode_Click" Tag="Fill">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="Crop24" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Crop to Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Zooms in uniformly to fill the entire screen while maintaining original aspect ratio, clipping excess outer edges without distortion." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.7" TextWrapping="Wrap" LineHeight="16" />
                                </StackPanel>
                            </Border>

                            <!-- Option 2: Fit to Screen (Fit) -->
                            <Border x:Name="ScalingFitCard" Grid.Column="2"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1.5" CornerRadius="8" Padding="14,12" Cursor="Hand"
                                    MouseLeftButtonUp="ScalingMode_Click" Tag="Fit">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="ScaleFill24" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Fit to Screen" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Preserves the entire uncropped video frame by scaling down to fit, leaving neutral black bars in the empty display areas." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.7" TextWrapping="Wrap" LineHeight="16" />
                                </StackPanel>
                            </Border>

                            <!-- Option 3: Stretch (Stretch) -->
                            <Border x:Name="ScalingStretchCard" Grid.Column="4"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1.5" CornerRadius="8" Padding="14,12" Cursor="Hand"
                                    MouseLeftButtonUp="ScalingMode_Click" Tag="Stretch">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="ArrowMaximize24" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Stretch (Fill Grid)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Forces the video to expand or contract to fill the display grid, which may cause horizontal or vertical aspect warping." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.7" TextWrapping="Wrap" LineHeight="16" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <TextBlock Text="CONNECTED MONITORS" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />

                <ItemsControl x:Name="DisplaysList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,12" Padding="0">
                            <StackPanel>
                                <!-- Header row -->
                                <Grid Margin="16,14,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border
                                            Width="44" Height="44"
                                            CornerRadius="8"
                                            Background="{StaticResource MxAccentSubtleBrush}"
                                            Margin="0,0,14,0">
                                            <ui:SymbolIcon
                                                Symbol="Desktop24"
                                                FontSize="22"
                                                Foreground="{StaticResource MxAccentBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    Text="{Binding DisplayName}"
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Border
                                                    Visibility="{Binding PrimaryVisibility}"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="PRIMARY"
                                                        FontSize="9"
                                                        FontWeight="Bold"
                                                        Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock
                                                Text="{Binding SpecsString}"
                                                FontSize="12"
                                                Margin="0,3,0,0"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Opacity="0.75" />
                                            <TextBlock
                                                Text="{Binding ActiveWallpaperString}"
                                                FontSize="12"
                                                Margin="0,2,0,0"
                                                Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Audio + Clear -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0"
                                            Visibility="{Binding HasAudioControls, Converter={StaticResource BoolToVis}}">
                                            <ui:Button
                                                Appearance="Secondary"
                                                Padding="8,6"
                                                ToolTip="{Binding MuteTooltip}"
                                                Click="MuteToggle_Click"
                                                Tag="{Binding DeviceId}"
                                                Margin="0,0,8,0">
                                                <Grid>
                                                    <ui:SymbolIcon Symbol="SpeakerOff24" FontSize="16" Foreground="#FF6B6B" Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}" />
                                                    <ui:SymbolIcon Symbol="Speaker224" FontSize="16" Visibility="{Binding IsNotMuted, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </ui:Button>
                                            <Slider
                                                Width="100"
                                                Minimum="0"
                                                Maximum="100"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding Volume, Mode=TwoWay}"
                                                ValueChanged="VolumeSlider_ValueChanged"
                                                Tag="{Binding DeviceId}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0" />
                                            <TextBlock
                                                Text="{Binding VolumeText}"
                                                FontSize="12"
                                                Width="36"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <ui:Button
                                            Content="Clear"
                                            Appearance="Secondary"
                                            Icon="{ui:SymbolIcon Dismiss24}"
                                            Click="ClearWallpaper_Click"
                                            Tag="{Binding DeviceId}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Per-monitor effects section -->
                                <Border
                                    Margin="16,0,16,4"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Padding="14,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Text="Display Effects"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:Button
                                                Grid.Column="1"
                                                Content="Reset"
                                                Appearance="Secondary"
                                                Padding="8,3"
                                                FontSize="11"
                                                Click="ResetMonitorEffects_Click"
                                                Tag="{Binding DeviceId}" />
                                        </Grid>

                                        <!-- Safe limits info -->
                                        <TextBlock
                                            Text="⚠ Brightness above 170% may increase OLED panel wear. Contrast above 220% may reduce detail in bright areas."
                                            FontSize="10"
                                            Foreground="#F59E0B"
                                            TextWrapping="Wrap"
                                            Margin="0,0,0,8"
                                            Opacity="0.85" />

                                        <!-- Brightness -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Brightness" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Slider
                                                Grid.Column="1"
                                                Minimum="5" Maximum="200"
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding BrightnessValue, Mode=TwoWay}"
                                                ValueChanged="BrightnessSlider_ValueChanged"
                                                Tag="{Binding DeviceId}"
                                                VerticalAlignment="Center" Margin="8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding BrightnessText}" FontSize="12" Width="40" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>

                                        <!-- Contrast -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Contrast" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Slider
                                                Grid.Column="1"
                                                Minimum="5" Maximum="250"
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding ContrastValue, Mode=TwoWay}"
                                                ValueChanged="ContrastSlider_ValueChanged"
                                                Tag="{Binding DeviceId}"
                                                VerticalAlignment="Center" Margin="8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding ContrastText}" FontSize="12" Width="40" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>

                                        <!-- Saturation -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Saturation" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Slider
                                                Grid.Column="1"
                                                Minimum="0" Maximum="300"
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding SaturationValue, Mode=TwoWay}"
                                                ValueChanged="SaturationSlider_ValueChanged"
                                                Tag="{Binding DeviceId}"
                                                VerticalAlignment="Center" Margin="8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding SaturationText}" FontSize="12" Width="40" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>

                                        <!-- Color Temperature -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Color Temp" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Slider
                                                Grid.Column="1"
                                                Minimum="-50" Maximum="50"
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding ColorTempValue, Mode=TwoWay}"
                                                ValueChanged="ColorTempSlider_ValueChanged"
                                                Tag="{Binding DeviceId}"
                                                VerticalAlignment="Center" Margin="8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding ColorTempText}" FontSize="12" Width="68" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Separator Margin="16,4" Opacity="0.2" />
                                <TextBlock
                                    Text="Note: Display Effects override the global Wallpaper Effects for this display only. Click Reset to revert to global settings."
                                    FontSize="10"
                                    Margin="16,0,16,12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Opacity="0.65" />
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
