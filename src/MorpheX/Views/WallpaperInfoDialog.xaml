<Window
    x:Class="MorpheX.WallpaperInfoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:MorpheX"
    Title="Wallpaper Info"
    Width="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False">

    <Window.Resources>
        <local:ThumbnailImageConverter x:Key="ThumbnailConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#77AABBFF" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#EEF0FF" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <!-- Drop-shadow wrapper -->
    <Border
        Background="#1C1C28"
        CornerRadius="12"
        BorderBrush="#303048"
        BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" Opacity="0.65" ShadowDepth="10" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="190" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── THUMBNAIL HEADER ── -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True" Background="#111118">
                <Grid>
                    <ui:SymbolIcon
                        Symbol="Image24"
                        FontSize="40"
                        Foreground="#20FFFFFF"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <Image
                        x:Name="ThumbnailImage"
                        Stretch="UniformToFill"
                        RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border VerticalAlignment="Bottom">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#D5000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Margin="18,0,18,14">
                            <TextBlock
                                x:Name="HeaderNameText"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="White"
                                TextTrimming="CharacterEllipsis"
                                Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <Border Padding="6,2" CornerRadius="4" Background="#CC000000" Margin="0,0,6,0">
                                    <TextBlock x:Name="TypeBadge" FontSize="10" FontWeight="SemiBold" Foreground="#CCFFFFFF" />
                                </Border>
                                <Border x:Name="ActiveBadge" Padding="6,2" CornerRadius="4" Background="#0D7A45" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Checkmark12" FontSize="9" Foreground="White" Margin="0,0,4,0" />
                                        <TextBlock Text="ACTIVE" FontSize="9" FontWeight="Bold" Foreground="White" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Close X -->
                    <Button
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,10,10,0" Width="28" Height="28"
                        Click="CloseButton_Click" Cursor="Hand" ToolTip="Close">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#99000000" CornerRadius="14" Width="28" Height="28">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="White" />
                    </Button>
                </Grid>
            </Border>

            <!-- ── CONTENT ── -->
            <ScrollViewer Grid.Row="1" MaxHeight="380" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,20,8">

                    <!-- Name / Rename -->
                    <TextBlock Text="NAME" Style="{StaticResource InfoLabel}" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            x:Name="NameTextBox"
                            Grid.Column="0"
                            PlaceholderText="Wallpaper name…"
                            FontSize="13"
                            Margin="0,0,8,0" />
                        <ui:Button
                            x:Name="SaveNameButton"
                            Grid.Column="1"
                            Content="Rename"
                            Appearance="Primary"
                            Click="SaveNameButton_Click" />
                    </Grid>

                    <!-- Tags -->
                    <TextBlock Text="TAGS" Style="{StaticResource InfoLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            x:Name="TagsTextBox"
                            Grid.Column="0"
                            PlaceholderText="tag1, tag2, tag3…"
                            FontSize="13"
                            Margin="0,0,8,0"
                            ToolTip="Comma-separated tags used for searching" />
                        <ui:Button
                            x:Name="SaveTagsButton"
                            Grid.Column="1"
                            Content="Save"
                            Appearance="Secondary"
                            Click="SaveTagsButton_Click" />
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="#22FFFFFF" Margin="0,16,0,4" />

                    <!-- Metadata grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="RESOLUTION" Style="{StaticResource InfoLabel}" />
                            <TextBlock x:Name="ResolutionText" Style="{StaticResource InfoValue}" Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="DURATION" Style="{StaticResource InfoLabel}" />
                            <TextBlock x:Name="DurationText" Style="{StaticResource InfoValue}" Text="—" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="FILE SIZE" Style="{StaticResource InfoLabel}" />
                            <TextBlock x:Name="FileSizeText" Style="{StaticResource InfoValue}" Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="DATE ADDED" Style="{StaticResource InfoLabel}" />
                            <TextBlock x:Name="DateAddedText" Style="{StaticResource InfoValue}" Text="—" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="FILE PATH" Style="{StaticResource InfoLabel}" />
                            <TextBlock
                                x:Name="FilePathText"
                                FontSize="12"
                                Foreground="#88CCFF"
                                TextWrapping="Wrap"
                                Cursor="Hand"
                                MouseLeftButtonDown="FilePathText_Click"
                                ToolTip="Click to open in Explorer" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="ID" Style="{StaticResource InfoLabel}" />
                            <TextBlock x:Name="IdText" FontSize="11" Foreground="#445566" FontFamily="Consolas" />
                        </StackPanel>
                    </Grid>

                    <Border Height="8" />
                </StackPanel>
            </ScrollViewer>

            <!-- ── FOOTER ── -->
            <Border Grid.Row="2" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button
                        Grid.Column="0"
                        Content="Open File Location"
                        Icon="{ui:SymbolIcon FolderOpen24}"
                        Appearance="Secondary"
                        Click="OpenLocationButton_Click" />
                    <ui:Button
                        Grid.Column="1"
                        Content="Done"
                        Appearance="Primary"
                        Click="CloseButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
