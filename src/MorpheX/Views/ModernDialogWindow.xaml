<Window
    x:Class="MorpheX.Views.ModernDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MorpheX"
    Width="440"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False">

    <Border
        Margin="14"
        Background="#17171F"
        CornerRadius="10"
        BorderBrush="#2A2A3C"
        BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" Opacity="0.7" ShadowDepth="6"/>
        </Border.Effect>

        <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Margin="20,16,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="WindowTitleText"
                    Grid.Column="0"
                    Text="MorpheX"
                    FontSize="11"
                    FontWeight="Medium"
                    Foreground="#606070"
                    VerticalAlignment="Center"/>
                <Button
                    Grid.Column="1"
                    x:Name="CloseIconButton"
                    Content="✕"
                    Width="26" Height="26"
                    FontSize="12"
                    Foreground="#606070"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CloseButton_Click"/>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="20,14,20,20">
                <!-- Icon strip (coloured left border accent instead of badge) -->
                <Border
                    x:Name="AccentBar"
                    Width="3" Height="0"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"/>

                <TextBlock
                    x:Name="HeadingText"
                    Text="Heading"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="#F0F0F8"
                    TextWrapping="Wrap"
                    Margin="0,0,0,8"/>

                <TextBlock
                    x:Name="MessageText"
                    Text="Body message."
                    FontSize="13"
                    Foreground="#9099B0"
                    TextWrapping="Wrap"
                    LineHeight="20"/>
            </StackPanel>

            <!-- Footer -->
            <Border
                Grid.Row="2"
                Background="#111118"
                CornerRadius="0,0,9,9"
                BorderBrush="#1E1E2C"
                BorderThickness="0,1,0,0"
                Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        x:Name="SecondaryButton"
                        Content="No"
                        Width="84" Height="32"
                        Margin="0,0,8,0"
                        FontSize="13"
                        Foreground="#9099B0"
                        Background="#1E1E2C"
                        BorderBrush="#2A2A3C"
                        BorderThickness="1"
                        Cursor="Hand"
                        IsCancel="True"
                        Click="SecondaryButton_Click"/>
                    <Button
                        x:Name="PrimaryButton"
                        Content="Yes"
                        Width="84" Height="32"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#FFFFFF"
                        Background="#3B3BCC"
                        BorderThickness="0"
                        Cursor="Hand"
                        IsDefault="True"
                        Click="PrimaryButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
