<Page
    x:Class="MorpheX.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:MorpheX">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:ThumbnailImageConverter x:Key="ThumbnailConverter" />
    </Page.Resources>

    <Grid Margin="28,20,28,24" AllowDrop="True" Drop="Grid_Drop" DragOver="Grid_DragOver">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Margin="0,0,0,12">
                <TextBlock
                    Text="Library"
                    Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    x:Name="WallpaperCountText"
                    Text="0 wallpapers"
                    Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox
                    x:Name="FilterCombo"
                    Width="108"
                    SelectedIndex="0"
                    SelectionChanged="FilterCombo_SelectionChanged"
                    Margin="0,0,8,6">
                    <ComboBoxItem Content="All types" Tag="All" />
                    <ComboBoxItem Content="Images" Tag="Image" />
                    <ComboBoxItem Content="Videos" Tag="Video" />
                </ComboBox>
                <ComboBox
                    x:Name="SortCombo"
                    Width="96"
                    SelectedIndex="0"
                    SelectionChanged="SortCombo_SelectionChanged"
                    Margin="0,0,8,6">
                    <ComboBoxItem Content="Newest" Tag="Newest" />
                    <ComboBoxItem Content="Name" Tag="Name" />
                </ComboBox>
                <ui:TextBox
                    x:Name="SearchBox"
                    Width="180"
                    MaxLength="100"
                    PlaceholderText="Search..."
                    Icon="{ui:SymbolIcon Search24}"
                    TextChanged="SearchBox_TextChanged"
                    ClearButtonEnabled="True"
                    VerticalAlignment="Center"
                    Margin="0,0,8,6" />
                <ui:Button
                    x:Name="AddWallpaperButton"
                    Content="Add Wallpaper"
                    Icon="{ui:SymbolIcon Add24}"
                    Appearance="Primary"
                    Click="AddWallpaperButton_Click"
                    Margin="0,0,8,6" />
                <ui:Button
                    Content="Import Folder"
                    Icon="{ui:SymbolIcon FolderAdd24}"
                    Appearance="Secondary"
                    Click="ImportFolderButton_Click"
                    Margin="0,0,8,6" />
                <ui:Button
                    x:Name="DeleteAllButton"
                    Content="Delete All"
                    Icon="{ui:SymbolIcon Delete24}"
                    Appearance="Secondary"
                    Foreground="#FF8888"
                    ToolTip="Delete all wallpapers from library"
                    Click="DeleteAllButton_Click"
                    Margin="0,0,8,6" />
                <ui:Button
                    x:Name="RefreshButton"
                    Icon="{ui:SymbolIcon ArrowSync24}"
                    ToolTip="Refresh library"
                    Click="RefreshButton_Click"
                    Margin="0,0,0,6" />
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,20" />

        <ScrollViewer
            x:Name="WallpapersScroll"
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="WallpaperGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardAction
                            Style="{StaticResource WallpaperCardStyle}"
                            Tag="{Binding}"
                            Click="WallpaperCard_Click">

                            <ui:CardAction.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Apply as Wallpaper" Click="ContextMenu_Apply_Click">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Play24" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Toggle Favorite" Click="ContextMenu_Favorite_Click">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Heart24" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Info / Rename" Click="ContextMenu_Info_Click">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Info24" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Open File Location" Click="ContextMenu_OpenLocation_Click">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Remove from Library" Click="ContextMenu_Delete_Click" Foreground="#FF8888">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" Foreground="#FF8888" /></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ui:CardAction.ContextMenu>

                            <Grid>
                                <!-- Background Image Thumbnail filling entire 16:9 card -->
                                <Border
                                    CornerRadius="10"
                                    ClipToBounds="True"
                                    Background="#111118">
                                    <Grid>
                                        <ui:SymbolIcon
                                            Symbol="Image24"
                                            FontSize="28"
                                            Foreground="#30FFFFFF"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <Image
                                            Source="{Binding PreviewImagePath, Converter={StaticResource ThumbnailConverter}}"
                                            Stretch="UniformToFill"
                                            RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>

                                <!-- Top Badges & Controls -->
                                <Grid VerticalAlignment="Top" Margin="8,8,8,0" Height="24">
                                    <Border
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Height="24"
                                        Padding="7,0"
                                        CornerRadius="4"
                                        Background="{StaticResource MxActiveBadgeBrush}"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Checkmark12" Foreground="White" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="ACTIVE" FontSize="9" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button
                                            Width="24" Height="24"
                                            Margin="0,0,6,0"
                                            Cursor="Hand"
                                            VerticalAlignment="Center"
                                            PreviewMouseLeftButtonDown="FavoriteButton_PreviewMouseLeftButtonDown"
                                            Click="FavoriteButton_Click"
                                            ToolTip="Toggle Favorite">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="#99000000" CornerRadius="12" Width="24" Height="24">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <ui:SymbolIcon Symbol="Heart24" FontSize="11" Foreground="{Binding FavoriteBrush}" VerticalAlignment="Center" />
                                        </Button>

                                        <Border
                                            Height="24"
                                            Padding="7,0"
                                            CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="#99000000">
                                            <TextBlock Text="{Binding Type}" FontSize="9" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Bottom Smoked-Glass Gradient Overlay with Title, Resolution, and ••• Menu Button -->
                                <Border
                                    VerticalAlignment="Bottom"
                                    Padding="10,14,8,8"
                                    CornerRadius="0,0,10,10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#CC09090D" Offset="0.38" />
                                            <GradientStop Color="#F009090D" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="#FFFFFF" />
                                            <TextBlock FontSize="10" Margin="0,2,0,0" Opacity="0.75" Foreground="#CBD5E1">
                                                <Run Text="{Binding Type, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding ResolutionText, Mode=OneWay, TargetNullValue='Auto'}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- ••• Card Context Menu Button -->
                                        <Button
                                            Grid.Column="1"
                                            Width="26" Height="26"
                                            Cursor="Hand"
                                            ToolTip="More Options"
                                            Click="CardMenuButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" Background="#55000000" CornerRadius="6" Width="26" Height="26">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource MxAccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14" Foreground="#FFFFFF" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ui:CardAction>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Visible">
            <Border
                Width="72" Height="72"
                CornerRadius="36"
                HorizontalAlignment="Center"
                Margin="0,0,0,20">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#1A38BDF8" Offset="0" />
                        <GradientStop Color="#0A0A0F" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <Image
                    Source="pack://application:,,,/MorpheX;component/Assets/Branding/morphex-icon.png"
                    Width="40" Height="40"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.75" />
            </Border>
            <TextBlock
                Text="No wallpapers yet"
                FontSize="17"
                FontWeight="Medium"
                HorizontalAlignment="Center"
                Margin="0,0,0,8"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock
                Text="Add your first live wallpaper to get started,&#x0a;or drag and drop files here."
                FontSize="12"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="280"
                Opacity="0.55"
                Margin="0,0,0,22"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <ui:Button
                Content="Add Wallpaper"
                Icon="{ui:SymbolIcon Add24}"
                Appearance="Primary"
                HorizontalAlignment="Center"
                Click="AddWallpaperButton_Click" />
        </StackPanel>

        <StackPanel
            x:Name="SearchEmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <Border
                Width="64" Height="64"
                CornerRadius="32"
                HorizontalAlignment="Center"
                Margin="0,0,0,20">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#1AA78BFA" Offset="0" />
                        <GradientStop Color="#0A0A0F" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <ui:SymbolIcon
                    Symbol="Search24"
                    FontSize="26"
                    Foreground="#A78BFA"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.7" />
            </Border>
            <TextBlock
                Text="No wallpapers found"
                FontSize="17"
                FontWeight="Medium"
                HorizontalAlignment="Center"
                Margin="0,0,0,8"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock
                Text="Try a different search term."
                FontSize="12"
                HorizontalAlignment="Center"
                Opacity="0.55"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

    </Grid>
</Page>
