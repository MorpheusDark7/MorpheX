<Window
    x:Class="MorpheX.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="460" Height="300"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStartupLocation="CenterScreen"
    Topmost="True"
    ShowInTaskbar="False"
    ResizeMode="NoResize">

    <Window.Resources>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
        <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut" />
    </Window.Resources>

    <Border
        x:Name="RootBorder"
        Background="#0A0A0F"
        CornerRadius="12"
        Opacity="0">

        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.8" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Canvas Grid.RowSpan="2" ClipToBounds="True">

                <Ellipse
                    x:Name="Arc1"
                    Width="500" Height="500"
                    Canvas.Left="-80" Canvas.Top="-280"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2038BDF8" Offset="0" />
                            <GradientStop Color="#00000000" Offset="0.6" />
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                    <Ellipse.StrokeThickness>1.5</Ellipse.StrokeThickness>
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="Arc1Rotate" Angle="0" CenterX="250" CenterY="250" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse
                    x:Name="Arc2"
                    Width="380" Height="380"
                    Canvas.Left="200" Canvas.Top="100"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Color="#20A78BFA" Offset="0" />
                            <GradientStop Color="#00000000" Offset="0.6" />
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                    <Ellipse.StrokeThickness>1</Ellipse.StrokeThickness>
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="Arc2Rotate" Angle="0" CenterX="190" CenterY="190" />
                    </Ellipse.RenderTransform>
                </Ellipse>

            </Canvas>

            <StackPanel
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,0,0,16">

                <Image
                    x:Name="BrandIcon"
                    Source="/Assets/Branding/morphex-icon.png"
                    Width="64" Height="64"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    HorizontalAlignment="Center"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="IconScale" ScaleX="0.85" ScaleY="0.85" />
                    </Image.RenderTransform>
                </Image>

                <TextBlock
                    x:Name="TitleText"
                    Text="MorpheX Live"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="#F0F0F5"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"
                    Opacity="0" />

                <TextBlock
                    x:Name="TaglineText"
                    Text="Live Wallpapers for Windows"
                    FontSize="12"
                    Foreground="#707080"
                    HorizontalAlignment="Center"
                    Margin="0,6,0,0"
                    Opacity="0" />

            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Margin="32,0,32,24"
                HorizontalAlignment="Stretch">

                <Grid Margin="0,0,0,8">
                    <TextBlock
                        x:Name="StatusText"
                        Text="Starting MorpheX..."
                        FontSize="11"
                        Foreground="#404050"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Opacity="0" />
                </Grid>

                <Border
                    Height="2"
                    CornerRadius="1"
                    Background="#1A1A2A"
                    Opacity="0"
                    x:Name="TrackBorder">
                    <Border.Effect>
                        <DropShadowEffect Color="#38BDF8" BlurRadius="4" ShadowDepth="0" Opacity="0.3" />
                    </Border.Effect>
                    <Border x:Name="ProgressFill"
                            Height="2"
                            CornerRadius="1"
                            HorizontalAlignment="Left"
                            Width="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#38BDF8" Offset="0" />
                                <GradientStop Color="#A78BFA" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>

            </StackPanel>
        </Grid>
    </Border>
</Window>
